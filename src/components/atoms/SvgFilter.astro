---
interface Props {
  filterId: string;
  width?: number;
  height?: number;
  blurStdDev?: number;
  scale?: number;
  specularAlpha?: number;
  saturation?: number;
  mode?: "standard" | "control";
}

const {
  filterId,
  width = 200,
  height = 140,
  blurStdDev = 0.5,
  scale = 50,
  specularAlpha = 0.8,
  saturation = 1.3,
  mode = "standard",
} = Astro.props;

const mapId = `${filterId}-map`;
const imageId = `${filterId}-image`;
const specularId = `${filterId}-specular`;
const alphaId = `${filterId}-alpha`;
const blurId = `${filterId}-blur`;
const saturationId = `${filterId}-saturation`;
---

<svg
  class="glass-filter-svg"
  aria-hidden="true"
>
  <defs>
    <filter
      id={filterId}
      x="-50%"
      y="-50%"
      width="200%"
      height="200%"
      color-interpolation-filters="sRGB"
    >
      <feGaussianBlur
        id={blurId}
        in="SourceGraphic"
        stdDeviation={blurStdDev.toString()}
        result="blurred"
      />
      <feImage
        id={imageId}
        href=""
        x="0"
        y="0"
        width={width}
        height={height}
        result="displacement_map"
        preserveAspectRatio="none"
      />
      <feDisplacementMap
        id={mapId}
        in="blurred"
        in2="displacement_map"
        scale={scale}
        xChannelSelector="R"
        yChannelSelector="G"
        result="displaced"
      />
      <feColorMatrix
        id={saturationId}
        in="displaced"
        type="saturate"
        values={saturation.toString()}
        result="displaced_saturated"
      />
      <feImage
        id={specularId}
        href=""
        x="0"
        y="0"
        width={width}
        height={height}
        result="specular_layer"
        preserveAspectRatio="none"
      />
      {
        mode === "control" && (
          <feComposite
            in="displaced_saturated"
            in2="specular_layer"
            operator="in"
            result="specular_saturated"
          />
        )
      }
      <feComponentTransfer in="specular_layer" result="specular_faded">
        <feFuncA
          id={alphaId}
          type="linear"
          slope={specularAlpha.toString()}
        />
      </feComponentTransfer>
      {
        mode === "control" ? (
          <>
            <feBlend
              in="specular_saturated"
              in2="displaced"
              mode="normal"
              result="withSaturation"
            />
            <feBlend
              in="specular_faded"
              in2="withSaturation"
              mode="normal"
            />
          </>
        ) : (
          <feBlend
            in="specular_faded"
            in2="displaced_saturated"
            mode="screen"
          />
        )
      }
    </filter>
  </defs>
</svg>
