---
interface Props {
  filterId: string;
  blurId?: string;
  imageId?: string;
  mapId?: string;
  specularImageId?: string;
  specularAlphaId?: string;
}

const { 
  filterId, 
  blurId = `${filterId}-blur`, 
  imageId = `${filterId}-image`, 
  mapId = `${filterId}-map`,
  specularImageId = `${filterId}-specular`,
  specularAlphaId = `${filterId}-alpha`
} = Astro.props;
---

<svg
  class="glass-filter-svg"
  style="width: 0; height: 0; position: absolute;"
  aria-hidden="true"
>
  <defs>
    <filter
      id={filterId}
      x="-50%"
      y="-50%"
      width="200%"
      height="200%"
      color-interpolation-filters="sRGB"
    >
      <feGaussianBlur
        id={blurId}
        in="SourceGraphic"
        stdDeviation="0.5"
        result="blurred"
      />
      <feImage
        id={imageId}
        href=""
        x="0"
        y="0"
        width="200"
        height="140"
        result="displacement_map"
        preserveAspectRatio="none"
      />
      <feDisplacementMap
        id={mapId}
        in="blurred"
        in2="displacement_map"
        scale="50"
        xChannelSelector="R"
        yChannelSelector="G"
        result="displaced"
      />
      <feColorMatrix
        in="displaced"
        type="saturate"
        values="1.3"
        result="displaced_saturated"
      />
      <feImage
        id={specularImageId}
        href=""
        x="0"
        y="0"
        width="200"
        height="140"
        result="specular_layer"
        preserveAspectRatio="none"
      />
      <feComponentTransfer
        in="specular_layer"
        result="specular_faded"
      >
        <feFuncA
          id={specularAlphaId}
          type="linear"
          slope="0.5"
        />
      </feComponentTransfer>
      <feBlend
        in="specular_faded"
        in2="displaced_saturated"
        mode="screen"
      />
    </filter>
  </defs>
</svg>
