---
interface Props {
  number: string;
  title: string;
  description: string;
  span?: string;
}

const { number, title, description, span = "col-span-12 md:col-span-6" } = Astro.props;
---

<article class={`flex flex-col border-b border-r border-gray-200 dark:border-gray-800 bg-white dark:bg-[#0a0a0a] p-6 sm:p-10 ${span}`}>
  <div class="mb-8 flex flex-col gap-2 z-10">
    <span class="text-xs font-mono font-semibold tracking-widest text-gray-400 dark:text-gray-500">{number}</span>
    <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white">{title}</h2>
    <p class="text-sm text-gray-600 dark:text-gray-400 max-w-sm">{description}</p>
  </div>
  
  <div class="relative w-full h-[400px] bg-gray-50 dark:bg-[#0f0f0f] border border-gray-200 dark:border-gray-800/50 flex items-center justify-center overflow-hidden">
    <slot />
  </div>
</article>
