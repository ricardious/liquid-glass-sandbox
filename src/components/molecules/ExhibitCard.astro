---
import { cn } from "../../lib/utils";

interface Props {
  number: string;
  title: string;
  description: string;
  span?: string;
}

const { number, title, description, span = "col-span-12 md:col-span-6" } = Astro.props;
---

<article class={cn("relative flex flex-col border-b border-r border-gray-200 bg-white p-6 sm:p-10 dark:border-gray-800 dark:bg-[#0a0a0a]", span)}>
  <div class="relative z-[10000] mb-8 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div class="flex flex-col gap-2">
      <span class="text-xs font-mono font-semibold tracking-widest text-gray-400 dark:text-gray-500">{number}</span>
      <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white">{title}</h2>
      <p class="text-sm text-gray-600 dark:text-gray-400 max-w-sm">{description}</p>
    </div>
    <div class="relative z-[10000] shrink-0 self-start">
      <slot name="actions" />
    </div>
  </div>
  
  <div class="relative z-0 w-full min-h-[400px] bg-gray-50 dark:bg-[#0f0f0f] border border-gray-200 dark:border-gray-800/50 flex items-center justify-center overflow-visible">
    <slot />
  </div>
</article>
