---
import ExternalLinkIcon from "@components/atoms/ExternalLinkIcon.astro";
import { primaryNav, projectLinks } from "@lib/site";
import { cn } from "@lib/utils";

interface Props {
  currentPath?: string;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const rawPath = Astro.props.currentPath ?? "/";
const currentPath = rawPath === "/" ? `${base}/` : `${base}${rawPath}`;
---

<nav
  class="w-full border-b border-black/6 bg-white/72 shadow-[inset_0_-1px_0_rgba(255,255,255,0.35)] backdrop-blur-xl dark:border-white/8 dark:bg-[#0a0a0a]/76 dark:shadow-[inset_0_-1px_0_rgba(255,255,255,0.06)]"
>
  <div
    class="mx-auto max-w-screen-2xl px-4 py-4 sm:px-6 md:px-8"
  >
    <div class="flex items-center justify-between gap-4 md:hidden">
      <a
        href={`${base}/`}
        class="inline-flex items-center text-zinc-900 dark:text-white"
        aria-label="Liquid Glass home"
      >
        <img
          src={`${base}/favicon.svg`}
          alt="Liquid Glass"
          class="h-7 w-7 sm:h-8 sm:w-8"
        />
      </a>
      <details class="group relative">
        <summary
          class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-full border border-black/8 text-zinc-700 transition hover:bg-white/55 hover:text-zinc-900 dark:border-white/8 dark:text-zinc-300 dark:hover:bg-white/10 dark:hover:text-white [&::-webkit-details-marker]:hidden"
          aria-label="Open navigation menu"
        >
          <span class="sr-only">Open navigation menu</span>
          <span class="relative block h-4 w-4">
            <span class="absolute left-0 top-[2px] h-[1.5px] w-4 rounded-full bg-current transition group-open:top-[7px] group-open:rotate-45"></span>
            <span class="absolute left-0 top-[7px] h-[1.5px] w-4 rounded-full bg-current transition group-open:opacity-0"></span>
            <span class="absolute left-0 top-[12px] h-[1.5px] w-4 rounded-full bg-current transition group-open:top-[7px] group-open:-rotate-45"></span>
          </span>
        </summary>
        <div class="absolute right-0 top-[calc(100%+0.75rem)] z-50 min-w-[220px] rounded-[1.25rem] border border-black/8 bg-white/92 p-2 shadow-[0_18px_60px_rgba(15,23,42,0.14)] backdrop-blur-xl dark:border-white/8 dark:bg-[#111111]/92 dark:shadow-[0_18px_60px_rgba(0,0,0,0.45)]">
          <div class="flex flex-col gap-1.5">
            {
              primaryNav.map((item) => (
                <a
                  href={item.href}
                  class={cn(
                    "rounded-2xl border px-3 py-2 text-[11px] tracking-[0.14em] uppercase transition",
                    currentPath === item.href
                      ? "border-zinc-900 bg-zinc-900 text-white dark:border-white dark:bg-white dark:text-black"
                      : "border-black/8 text-zinc-600 hover:bg-black/[0.035] hover:text-zinc-900 dark:border-white/8 dark:text-zinc-400 dark:hover:bg-white/10 dark:hover:text-white",
                  )}
                >
                  {item.label}
                </a>
              ))
            }
            <a
              href={projectLinks.article.url}
              target="_blank"
              rel="noreferrer"
              class="group flex items-center justify-between gap-2 rounded-2xl border border-black/8 px-3 py-2 text-[11px] tracking-[0.14em] uppercase text-zinc-600 transition hover:bg-black/[0.035] hover:text-zinc-900 dark:border-white/8 dark:text-zinc-400 dark:hover:bg-white/10 dark:hover:text-white"
            >
              <span>Article<span class="sr-only"> (opens in new tab)</span></span>
              <ExternalLinkIcon />
            </a>
            <a
              href={projectLinks.github.url}
              target="_blank"
              rel="noreferrer"
              class="group flex items-center justify-between gap-2 rounded-2xl border border-black/8 px-3 py-2 text-[11px] tracking-[0.14em] uppercase text-zinc-600 transition hover:bg-black/[0.035] hover:text-zinc-900 dark:border-white/8 dark:text-zinc-400 dark:hover:bg-white/10 dark:hover:text-white"
            >
              <span>GitHub<span class="sr-only"> (opens in new tab)</span></span>
              <ExternalLinkIcon />
            </a>
          </div>
        </div>
      </details>
    </div>

    <div class="hidden items-center justify-between gap-6 md:flex">
      <a
        href={`${base}/`}
        class="inline-flex items-center text-zinc-900 dark:text-white"
        aria-label="Liquid Glass home"
      >
        <img
          src={`${base}/favicon.svg`}
          alt="Liquid Glass"
          class="h-8 w-8"
        />
      </a>
      <div
        class="flex items-center justify-end gap-3"
      >
        {
          primaryNav.map((item) => (
            <a
              href={item.href}
              class={cn(
                "rounded-full border px-3 py-1.5 text-xs tracking-[0.16em] uppercase transition",
                currentPath === item.href
                  ? "border-zinc-900 bg-zinc-900 text-white dark:border-white dark:bg-white dark:text-black"
                  : "border-black/8 text-zinc-600 hover:bg-white/55 hover:text-zinc-900 dark:border-white/8 dark:text-zinc-400 dark:hover:bg-white/10 dark:hover:text-white",
              )}
            >
              {item.label}
            </a>
          ))
        }
        <a
          href={projectLinks.article.url}
          target="_blank"
          rel="noreferrer"
          class="group inline-flex items-center gap-1.5 rounded-full border border-black/8 px-3 py-1.5 text-xs tracking-[0.16em] uppercase text-zinc-600 transition hover:bg-white/55 hover:text-zinc-900 dark:border-white/8 dark:text-zinc-400 dark:hover:bg-white/10 dark:hover:text-white"
        >
          Article<span class="sr-only"> (opens in new tab)</span>
          <ExternalLinkIcon />
        </a>
        <a
          href={projectLinks.github.url}
          target="_blank"
          rel="noreferrer"
          class="group inline-flex items-center gap-1.5 rounded-full border border-black/8 px-3 py-1.5 text-xs tracking-[0.16em] uppercase text-zinc-600 transition hover:bg-white/55 hover:text-zinc-900 dark:border-white/8 dark:text-zinc-400 dark:hover:bg-white/10 dark:hover:text-white"
        >
          GitHub<span class="sr-only"> (opens in new tab)</span>
          <ExternalLinkIcon />
        </a>
      </div>
    </div>
  </div>
</nav>
