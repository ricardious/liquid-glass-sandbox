---
import { primaryNav, projectLinks } from "@lib/site";
import { cn } from "@lib/utils";

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;
---

<nav
  class="w-full border-b border-black/6 bg-white/72 shadow-[inset_0_-1px_0_rgba(255,255,255,0.35)] backdrop-blur-xl dark:border-white/8 dark:bg-[#0a0a0a]/76 dark:shadow-[inset_0_-1px_0_rgba(255,255,255,0.06)]"
>
  <div
    class="mx-auto flex max-w-screen-2xl flex-col items-start justify-between gap-4 px-4 py-4 sm:px-6 md:flex-row md:items-center md:gap-6 md:px-8"
  >
    <a
      href="/"
      class="inline-flex items-center text-zinc-900 dark:text-white"
      aria-label="Liquid Glass home"
    >
      <img
        src="/favicon.svg"
        alt="Liquid Glass"
        class="h-7 w-7 sm:h-8 sm:w-8"
      />
    </a>

    <div
      class="flex w-full flex-wrap items-center justify-start gap-2 sm:gap-3 md:w-auto md:justify-end"
    >
      {
        primaryNav.map((item) => (
          <a
            href={item.href}
            class={cn(
              "rounded-full border px-3 py-1.5 text-[10px] tracking-[0.16em] uppercase transition sm:text-xs",
              currentPath === item.href
                ? "border-zinc-900 bg-zinc-900 text-white dark:border-white dark:bg-white dark:text-black"
                : "border-black/8 text-zinc-600 hover:bg-white/55 hover:text-zinc-900 dark:border-white/8 dark:text-zinc-400 dark:hover:bg-white/10 dark:hover:text-white",
            )}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={projectLinks.article.url}
        target="_blank"
        rel="noreferrer"
        class="rounded-full border border-black/8 px-3 py-1.5 text-[10px] tracking-[0.16em] uppercase text-zinc-600 transition hover:bg-white/55 hover:text-zinc-900 dark:border-white/8 dark:text-zinc-400 dark:hover:bg-white/10 dark:hover:text-white sm:text-xs"
      >
        Article
      </a>
      <a
        href={projectLinks.github.url}
        target="_blank"
        rel="noreferrer"
        class="rounded-full border border-black/8 px-3 py-1.5 text-[10px] tracking-[0.16em] uppercase text-zinc-600 transition hover:bg-white/55 hover:text-zinc-900 dark:border-white/8 dark:text-zinc-400 dark:hover:bg-white/10 dark:hover:text-white sm:text-xs"
      >
        GitHub
      </a>
    </div>
  </div>
</nav>
