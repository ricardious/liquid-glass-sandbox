---
import SvgFilter from "../atoms/SvgFilter.astro";
import flowers from "../../assets/orchid-tropical-pattern-dark.webp";

const filterId = "clock-glass-filter";
const clockDiameter = 320;
---

<div class="relative h-full min-h-[600px] w-full overflow-hidden p-4 sm:p-8" id="clock-demo-area">
  <div
    id="clock-real-world"
    class="absolute inset-4 overflow-hidden rounded-3xl bg-[#0b1016] bg-cover bg-center pointer-events-none sm:inset-8"
    style={`background-image: url(${flowers.src});`}
  >
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(255,255,255,0.16),transparent_24%),radial-gradient(circle_at_78%_30%,rgba(255,255,255,0.12),transparent_22%),linear-gradient(180deg,rgba(7,12,18,0.18),rgba(8,12,16,0.62))]"></div>
  </div>

  <div class="relative z-10 flex h-full items-center justify-center p-8">
    <div
      id="liquid-clock-container"
      data-controls="clock-controls"
      class="relative cursor-pointer overflow-hidden rounded-full will-change-transform"
      style={`width: ${clockDiameter}px; height: ${clockDiameter}px;`}
    >
      <div class="pointer-events-none absolute inset-0 overflow-hidden rounded-full">
        <div id="clock-content-clone" class="glass-clone-wrap absolute inset-0 rounded-full">
          <div
            id="clock-clone-inner"
            class="glass-clone-inner absolute inset-0 rounded-full bg-cover bg-center"
          ></div>
        </div>
      </div>

      <SvgFilter
        filterId={filterId}
        width={clockDiameter}
        height={clockDiameter}
        blurStdDev={0.1}
        saturation={1.2}
        specularAlpha={0.55}
      />

      <div
        id="clock-face-overlay"
        class="glass-inner-overlay rounded-full border-2 border-white/10 bg-white/8 shadow-[30px_30px_35px_rgba(0,0,0,0.25),inset_0_2px_5px_rgba(255,255,255,0.3)]"
      >
        <img
          src="https://dl.dropbox.com/s/f3b3lyanili7zl2/clock%20template-01.svg?raw=1"
          alt="Clock face"
          class="pointer-events-none absolute inset-0 m-auto h-[90%] w-[90%] object-contain opacity-60"
        />
        <div class="absolute inset-0">
          <div id="clock-hour" class="absolute left-1/2 top-[100px] z-20 h-[60px] w-[10px] -translate-x-1/2 rounded-md bg-white/25 shadow-[inset_0_1px_1px_rgba(255,255,255,0.2)] [transform-origin:bottom_center]"></div>
          <div id="clock-minute" class="absolute left-1/2 top-[80px] z-20 h-[80px] w-[5px] -translate-x-1/2 rounded-md bg-white/25 shadow-[inset_0_1px_1px_rgba(255,255,255,0.2)] [transform-origin:bottom_center]"></div>
          <div id="clock-seconds" class="absolute left-1/2 top-[70px] z-20 h-[90px] w-[3px] -translate-x-1/2 rounded-md bg-rose-300/65 [transform-origin:bottom_center]"></div>
          <div class="absolute left-1/2 top-1/2 z-20 size-4 -translate-x-1/2 -translate-y-1/2 rounded-full border border-white/20 bg-white/35"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { Spring } from "../../quarks/spring";
  import {
    applyLiquidAssets,
    bindLiquidControls,
    createLiquidAssets,
    syncCloneContent,
    updateLiquidFilter,
  } from "../../quarks/liquidGlassEngine";

  class ClockExhibit {
    private container: HTMLElement;
    private cloneInner: HTMLElement;
    private cloneWrapper: HTMLElement;
    private demoArea: HTMLElement;
    private realWorld: HTMLElement;
    private hourHand: HTMLElement;
    private minuteHand: HTMLElement;
    private secondsHand: HTMLElement;
    private modal: HTMLElement | null;
    private modalPanel: HTMLElement | null;
    private modalSurface: HTMLElement | null;

    private controls = {
      hoverScale: 1.03,
      refraction: 0.55,
      blur: 0.1,
      specularOpacity: 0.55,
      saturation: 1.2,
    };

    private scaleSpring = new Spring(1, 200, 20);
    private af: number | null = null;
    private maxDisp = 0;

    constructor() {
      this.container = document.getElementById("liquid-clock-container") as HTMLElement;
      this.cloneInner = document.getElementById("clock-clone-inner") as HTMLElement;
      this.cloneWrapper = document.getElementById("clock-content-clone") as HTMLElement;
      this.demoArea = document.getElementById("clock-demo-area") as HTMLElement;
      this.realWorld = document.getElementById("clock-real-world") as HTMLElement;
      this.hourHand = document.getElementById("clock-hour") as HTMLElement;
      this.minuteHand = document.getElementById("clock-minute") as HTMLElement;
      this.secondsHand = document.getElementById("clock-seconds") as HTMLElement;
      this.modal = document.getElementById("clock-controls-modal");
      this.modalPanel = this.modal?.querySelector(
        "[data-clock-modal-panel]",
      ) as HTMLElement | null;
      this.modalSurface = this.modal?.querySelector(
        "[data-modal-surface]",
      ) as HTMLElement | null;

      if (!this.container) return;
      this.init();
    }

    private init() {
      const assets = createLiquidAssets({
        width: 320,
        height: 320,
        radius: 160,
        bezelWidth: 30,
        glassThickness: 80,
        refractiveIndex: 1.5,
      });
      this.maxDisp = assets.maximumDisplacement;
      applyLiquidAssets("clock-glass-filter", assets);
      syncCloneContent(this.cloneInner, this.realWorld);
      this.cloneWrapper.style.filter = "url(#clock-glass-filter)";
      this.syncFilterTuning();

      this.startClock();
      this.bindInteractions();
      this.bindControls();
      this.bindModal();
      this.updateClone();
    }

    private bindInteractions() {
      this.container.addEventListener("mouseenter", () => {
        this.scaleSpring.setTarget(this.controls.hoverScale);
        this.startLoop();
      });
      this.container.addEventListener("mouseleave", () => {
        this.scaleSpring.setTarget(1);
        this.startLoop();
      });
      window.addEventListener("resize", this.updateClone.bind(this));
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") this.setModal(false);
      });
    }

    private bindControls() {
      bindLiquidControls(
        this.container,
        this.controls,
        () => {
          this.syncFilterTuning();
          this.startLoop();
        },
        () => {
          Object.assign(this.controls, {
            hoverScale: 1.03,
            refraction: 0.55,
            blur: 0.1,
            specularOpacity: 0.55,
            saturation: 1.2,
          });
          this.syncFilterTuning();
          this.startLoop();
        },
      );
    }

    private bindModal() {
      document
        .querySelector("[data-open-clock-controls]")
        ?.addEventListener("click", () => {
          this.setModal(true);
        });
      this.modal
        ?.querySelector("[data-close-clock-controls]")
        ?.addEventListener("click", () => {
          this.setModal(false);
        });
    }

    private setModal(open: boolean) {
      if (!this.modal || !this.modalPanel) return;
      const hiddenOffsetClass =
        this.modalPanel.dataset.modalOffsetClass ?? "translate-y-[0.75rem]";
      this.modal.classList.toggle("pointer-events-none", !open);
      this.modal.classList.toggle("opacity-0", !open);
      this.modalPanel.classList.toggle(hiddenOffsetClass, !open);
      this.modalSurface?.classList.toggle("pointer-events-auto", open);
      this.modalSurface?.classList.toggle("pointer-events-none", !open);
    }

    private syncFilterTuning() {
      updateLiquidFilter("clock-glass-filter", {
        scale: this.maxDisp * this.controls.refraction,
        blurStdDev: this.controls.blur,
        saturation: this.controls.saturation,
        specularAlpha: this.controls.specularOpacity,
      });
    }

    private startClock() {
      const tick = () => {
        const now = new Date();
        const hours = now.getHours();
        const minutes = now.getMinutes();
        const seconds = now.getSeconds();

        this.hourHand.style.transform = `translateX(-50%) rotate(${hours * 30 + minutes / 2}deg)`;
        this.minuteHand.style.transform = `translateX(-50%) rotate(${minutes * 6}deg)`;
        this.secondsHand.style.transform = `translateX(-50%) rotate(${seconds * 6}deg)`;
      };

      tick();
      window.setInterval(tick, 1000);
    }

    private updateClone() {
      const areaRect = this.demoArea.getBoundingClientRect();
      const rect = this.container.getBoundingClientRect();
      const offsetX = rect.left - areaRect.left;
      const offsetY = rect.top - areaRect.top;
      this.cloneInner.style.width = areaRect.width + "px";
      this.cloneInner.style.height = areaRect.height + "px";
      this.cloneInner.style.transform = `translate(${-offsetX}px, ${-offsetY}px)`;
    }

    private loop = () => {
      const dt = Math.min(0.032, 1 / 60);
      const scale = this.scaleSpring.update(dt);
      this.container.style.transform = `scale(${scale})`;
      this.updateClone();

      if (!this.scaleSpring.isSettled()) {
        this.af = requestAnimationFrame(this.loop);
      } else {
        this.af = null;
      }
    };

    private startLoop() {
      if (!this.af) this.af = requestAnimationFrame(this.loop);
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    new ClockExhibit();
  });
</script>
