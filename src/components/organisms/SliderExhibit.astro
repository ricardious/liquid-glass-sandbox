---
import flowers from "@assets/botanical-floral-pattern-aqua.webp";
import SvgFilter from "@components/atoms/SvgFilter.astro";
import LiquidControls from "@components/molecules/LiquidControls.astro";

const filterId = "slider-glass-filter";
const trackH = 14;
const desktopThumbW = 90;
const desktopThumbH = 60;
---

<div class="slider-demo-root flex w-full flex-col">
  <div
    class="grid w-full items-stretch gap-5 p-4 lg:grid-cols-[minmax(0,1fr)_16rem] lg:gap-6 lg:p-6 xl:grid-cols-[minmax(0,1fr)_17rem]"
    id="slider-demo-shell"
  >
    <div class="relative min-h-[320px] w-full self-stretch overflow-hidden rounded-2xl lg:min-h-0" id="slider-demo-area">
      <div id="slider-real-world" class="absolute inset-0 pointer-events-none overflow-hidden rounded-2xl bg-[#091119]">
        <div
          class="slider-background-motion h-full w-full bg-cover bg-center"
          style={`background-image: url(${flowers.src});`}
        >
        </div>
        <div
          class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(255,255,255,0.16),transparent_24%),radial-gradient(circle_at_80%_30%,rgba(255,255,255,0.12),transparent_22%),linear-gradient(180deg,rgba(7,12,18,0.08),rgba(8,12,16,0.52))]"
        >
        </div>
      </div>

      <div class="relative z-10 flex h-full flex-col items-center justify-center gap-10 px-4 sm:gap-12 sm:px-6">
        <div id="slider-value-display" class="font-mono text-4xl font-bold tracking-tighter text-white drop-shadow-[0_6px_18px_rgba(0,0,0,0.45)] sm:text-5xl">10%</div>

        <div
          id="liquid-slider-container"
          data-controls="slider-controls"
          class="relative z-10"
          style="width: var(--slider-track-width); height: var(--slider-thumb-height);"
        >
          <div
            id="liquid-slider-track"
            class="absolute left-0 top-[23px] cursor-pointer rounded-full bg-[rgba(137,137,143,0.4)] shadow-[inset_0_2px_4px_rgba(0,0,0,0.3)]"
            style={`top: calc((var(--slider-thumb-height) - ${trackH}px) / 2); width: var(--slider-track-width); height: ${trackH}px;`}
          ></div>
          <div
            id="liquid-slider-active-track"
            class="pointer-events-none absolute left-0 top-[23px] rounded-full bg-[#0377f7] shadow-[0_0_10px_rgba(3,119,247,0.5)]"
            style={`top: calc((var(--slider-thumb-height) - ${trackH}px) / 2); width: 10%; height: ${trackH}px;`}
          ></div>

          <div
            id="liquid-slider-thumb"
            class="absolute left-0 top-0 z-10 cursor-grab touch-none will-change-transform active:cursor-grabbing"
            style="width: var(--slider-thumb-width); height: var(--slider-thumb-height); border-radius: calc(var(--slider-thumb-height) / 2); transform-origin: center center;"
          >
            <div class="pointer-events-none absolute inset-0 overflow-hidden rounded-[inherit]">
              <div id="slider-content-clone" class="glass-clone-wrap absolute inset-0 rounded-[inherit] opacity-0">
                <div id="slider-clone-inner" class="slider-clone-inner glass-clone-inner bg-white dark:bg-[#0f0f0f]"></div>
              </div>
            </div>

            <SvgFilter
              filterId={filterId}
              width={desktopThumbW}
              height={desktopThumbH}
              blurStdDev={0}
              saturation={7}
              specularAlpha={0.4}
              mode="control"
            />

            <div id="slider-thumb-inner" class="glass-inner-overlay rounded-[inherit] shadow-[0_3px_14px_rgba(0,0,0,0.1)]"></div>
          </div>
        </div>
      </div>
    </div>

    <div class="min-w-0 self-stretch">
      <LiquidControls
        title="Slider Parameters"
        target="slider-controls"
        className="mt-0! w-full max-w-none self-start"
        controls={[
          { key: "forceActive", label: "Force Active", type: "toggle", value: false },
          { key: "refraction", label: "Refraction", min: 0, max: 1.4, step: 0.01, value: 1 },
          { key: "blur", label: "Blur", min: 0, max: 4, step: 0.01, value: 0 },
          { key: "specularOpacity", label: "Specular", min: 0, max: 1, step: 0.01, value: 0.4 },
          { key: "saturation", label: "Saturation", min: 0, max: 12, step: 0.1, value: 7 },
        ]}
      />
    </div>
  </div>
</div>

<script>
  import { Spring } from "@quarks/spring";
  import {
    applyLiquidAssets,
    bindLiquidControls,
    createLiquidAssets,
    syncCloneContent,
    updateLiquidFilter,
  } from "@quarks/liquidGlassEngine";

  class SliderExhibit {
    private static readonly MOBILE_BREAKPOINT = 640;
    private track: HTMLElement;
    private activeTrack: HTMLElement;
    private thumb: HTMLElement;
    private cloneInner: HTMLElement;
    private demoArea: HTMLElement;
    private realWorld!: HTMLElement;
    private cloneWrapper: HTMLElement;
    private valueDisplay: HTMLElement;
    private container: HTMLElement;

    private readonly config = {
      trackW: 0,
      trackH: 14,
      thumbW: 0,
      thumbH: 0,
      thumbR: 0,
      bezelWidth: 16,
      glassThickness: 80,
      refractiveIndex: 1.45,
      restScale: 0.6,
      activeScale: 1,
    };

    private controls = {
      forceActive: false,
      refraction: 1,
      blur: 0,
      specularOpacity: 0.4,
      saturation: 7,
    };

    private state = {
      isDragging: false,
      value: 10,
      maxDisp: 0,
    };

    private springs = {
      scale: new Spring(0.6, 2000, 80),
      bgOpacity: new Spring(1, 2000, 80),
      dispScale: new Spring(0.4, 100, 10),
    };

    private af: number | null = null;

    constructor() {
      this.container = document.getElementById("liquid-slider-container") as HTMLElement;
      this.track = document.getElementById("liquid-slider-track") as HTMLElement;
      this.activeTrack = document.getElementById("liquid-slider-active-track") as HTMLElement;
      this.thumb = document.getElementById("liquid-slider-thumb") as HTMLElement;
      this.cloneInner = document.getElementById("slider-clone-inner") as HTMLElement;
      this.demoArea = document.getElementById("slider-demo-area") as HTMLElement;
      this.realWorld = document.getElementById("slider-real-world") as HTMLElement;
      this.cloneWrapper = document.getElementById("slider-content-clone") as HTMLElement;
      this.valueDisplay = document.getElementById("slider-value-display") as HTMLElement;

      if (!this.track) return;
      this.init();
    }

    private init() {
      syncCloneContent(this.cloneInner, this.realWorld);
      this.cloneWrapper.style.filter = "url(#slider-glass-filter)";
      this.applyResponsiveConfig();
      this.regenerate();
      this.syncFilterTuning();
      this.bindControls();

      this.thumb.addEventListener("pointerdown", this.onPointerDown.bind(this));
      this.track.addEventListener("pointerdown", (event) => {
        this.onPointerDown(event);
        this.onPointerMove(event);
      });
      window.addEventListener("pointermove", this.onPointerMove.bind(this));
      window.addEventListener("pointerup", this.onPointerUp.bind(this));
      window.addEventListener("resize", this.handleResize);

      this.updateSliderUI();
      this.startLoop();
    }

    private getResponsiveConfig() {
      if (window.innerWidth < SliderExhibit.MOBILE_BREAKPOINT) {
        return {
          trackW: 260,
          thumbW: 76,
          thumbH: 52,
          thumbR: 26,
        };
      }

      return {
        trackW: 330,
        thumbW: 90,
        thumbH: 60,
        thumbR: 30,
      };
    }

    private applyResponsiveConfig() {
      const nextConfig = this.getResponsiveConfig();

      if (
        this.config.trackW === nextConfig.trackW &&
        this.config.thumbW === nextConfig.thumbW &&
        this.config.thumbH === nextConfig.thumbH &&
        this.config.thumbR === nextConfig.thumbR
      ) {
        return;
      }

      Object.assign(this.config, nextConfig);
      this.container.style.width = `${this.config.trackW}px`;
      this.container.style.height = `${this.config.thumbH}px`;
      this.track.style.width = `${this.config.trackW}px`;
      this.activeTrack.style.height = `${this.config.trackH}px`;
      this.track.style.height = `${this.config.trackH}px`;
      this.track.style.top = `${(this.config.thumbH - this.config.trackH) / 2}px`;
      this.activeTrack.style.top = `${(this.config.thumbH - this.config.trackH) / 2}px`;
      this.thumb.style.width = `${this.config.thumbW}px`;
      this.thumb.style.height = `${this.config.thumbH}px`;
      this.thumb.style.borderRadius = `${this.config.thumbR}px`;

      const image = document.getElementById("slider-glass-filter-image");
      const specular = document.getElementById("slider-glass-filter-specular");
      image?.setAttribute("width", String(this.config.thumbW));
      image?.setAttribute("height", String(this.config.thumbH));
      specular?.setAttribute("width", String(this.config.thumbW));
      specular?.setAttribute("height", String(this.config.thumbH));
    }

    private regenerate() {
      const assets = createLiquidAssets({
        width: this.config.thumbW,
        height: this.config.thumbH,
        radius: this.config.thumbR,
        bezelWidth: this.config.bezelWidth,
        glassThickness: this.config.glassThickness,
        refractiveIndex: this.config.refractiveIndex,
      });
      this.state.maxDisp = assets.maximumDisplacement;
      applyLiquidAssets("slider-glass-filter", assets);
    }

    private handleResize = () => {
      const previous = {
        trackW: this.config.trackW,
        thumbW: this.config.thumbW,
        thumbH: this.config.thumbH,
        thumbR: this.config.thumbR,
      };

      this.applyResponsiveConfig();

      if (
        previous.trackW !== this.config.trackW ||
        previous.thumbW !== this.config.thumbW ||
        previous.thumbH !== this.config.thumbH ||
        previous.thumbR !== this.config.thumbR
      ) {
        this.regenerate();
      }

      this.updateSliderUI();
      this.startLoop();
    };

    private bindControls() {
      bindLiquidControls(
        this.container,
        this.controls,
        () => {
          this.syncFilterTuning();
          this.startLoop();
        },
        () => {
          Object.assign(this.controls, {
            forceActive: false,
            refraction: 1,
            blur: 0,
            specularOpacity: 0.4,
            saturation: 7,
          });
          this.syncFilterTuning();
          this.startLoop();
        },
      );
    }

    private syncFilterTuning() {
      updateLiquidFilter("slider-glass-filter", {
        blurStdDev: this.controls.blur,
        saturation: this.controls.saturation,
        specularAlpha: this.controls.specularOpacity,
      });
    }

    private updateSliderUI() {
      this.activeTrack.style.width = `${this.state.value}%`;
      const thumbWidthRest = this.config.thumbW * this.config.restScale;
      const ratio = this.state.value / 100;
      const x0 = thumbWidthRest / 2;
      const x100 = this.config.trackW - thumbWidthRest / 2;
      const thumbCenterX = x0 + ratio * (x100 - x0);
      const thumbX = thumbCenterX - this.config.thumbW / 2;
      this.thumb.style.left = `${thumbX}px`;

      const areaRect = this.demoArea.getBoundingClientRect();
      const containerLeft = (areaRect.width - this.config.trackW) / 2;
      const containerTop = (areaRect.height - this.config.thumbH) / 2;
      const trackTop = (this.config.thumbH - this.config.trackH) / 2;

      this.cloneInner.style.width = `${areaRect.width}px`;
      this.cloneInner.style.height = `${areaRect.height}px`;
      this.cloneInner.style.transform = `translate(${-(containerLeft + thumbX)}px, ${-containerTop}px)`;
      this.cloneInner.style.setProperty("--track-left", `${containerLeft}px`);
      this.cloneInner.style.setProperty("--track-top", `${containerTop + trackTop}px`);
      this.cloneInner.style.setProperty("--track-width", `${this.config.trackW}px`);
      this.cloneInner.style.setProperty("--track-height", `${this.config.trackH}px`);
      this.cloneInner.style.setProperty("--fill-width", this.state.value.toString());
      this.valueDisplay.innerText = `${Math.round(this.state.value)}%`;
    }

    private onPointerDown(event: PointerEvent) {
      event.preventDefault();
      this.state.isDragging = true;
      this.startLoop();
    }

    private onPointerMove(event: PointerEvent) {
      if (!this.state.isDragging) return;
      event.preventDefault();

      const trackRect = this.track.getBoundingClientRect();
      const thumbWidthRest = this.config.thumbW * this.config.restScale;
      const x0 = trackRect.left + thumbWidthRest / 2;
      const x100 = trackRect.right - thumbWidthRest / 2;
      const nextX = Math.max(x0, Math.min(x100, event.clientX));
      this.state.value = Math.max(0, Math.min(100, ((nextX - x0) / (x100 - x0)) * 100));
      this.updateSliderUI();
      this.startLoop();
    }

    private onPointerUp() {
      if (!this.state.isDragging) return;
      this.state.isDragging = false;
      this.startLoop();
    }

    private loop = () => {
      const dt = Math.min(0.032, 1 / 60);
      const isActive = this.state.isDragging || this.controls.forceActive;

      this.springs.scale.setTarget(isActive ? this.config.activeScale : this.config.restScale);
      this.springs.bgOpacity.setTarget(isActive ? 0.1 : 1);
      this.springs.dispScale.setTarget((isActive ? 0.9 : 0.4) * this.controls.refraction);

      const scale = this.springs.scale.update(dt);
      const bgOpacity = this.springs.bgOpacity.update(dt);
      const dispScale = this.springs.dispScale.update(dt);

      this.thumb.style.transform = `scale(${scale})`;
      this.thumb.style.backgroundColor = `rgba(255,255,255,${bgOpacity})`;
      this.cloneWrapper.style.opacity = `${1 - bgOpacity}`;

      updateLiquidFilter("slider-glass-filter", {
        scale: this.state.maxDisp * dispScale,
      });

      if (!Object.values(this.springs).every((spring) => spring.isSettled())) {
        this.af = requestAnimationFrame(this.loop);
      } else {
        this.af = null;
      }
    };

    private startLoop() {
      if (!this.af) this.af = requestAnimationFrame(this.loop);
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    new SliderExhibit();
  });
</script>

<style>
  .slider-demo-root {
    --slider-track-width: 260px;
    --slider-thumb-width: 76px;
    --slider-thumb-height: 52px;
  }

  @media (min-width: 640px) {
    .slider-demo-root {
      --slider-track-width: 330px;
      --slider-thumb-width: 90px;
      --slider-thumb-height: 60px;
    }
  }

  .slider-background-motion {
    transform-origin: center;
    animation: sliderBackgroundOrbit 20s ease-in-out infinite;
    will-change: transform;
  }

  @keyframes sliderBackgroundOrbit {
    0% {
      transform: translate3d(0, -2%, 0) scale(1.08) rotate(0deg);
    }

    25% {
      transform: translate3d(2%, 0, 0) scale(1.14) rotate(1.5deg);
    }

    50% {
      transform: translate3d(0, 2%, 0) scale(1.2) rotate(0deg);
    }

    75% {
      transform: translate3d(-2%, 0, 0) scale(1.14) rotate(-1.5deg);
    }

    100% {
      transform: translate3d(0, -2%, 0) scale(1.08) rotate(0deg);
    }
  }
</style>
