---
import flowers from "@assets/botanical-bloom-pattern-magenta.webp";
import SvgFilter from "@components/atoms/SvgFilter.astro";

const filterId = "cursor-glass-filter";
const cursorSize = 90;
const cursorR = 45;
---

<div
  class="relative h-full w-full overflow-hidden p-4 sm:p-8 cursor-none"
  id="cursor-demo-area"
>
  <div
    id="cursor-real-world"
    class="cursor-real-world absolute inset-4 flex items-center justify-center overflow-hidden rounded-3xl bg-[#091119] bg-center bg-no-repeat pointer-events-none sm:inset-8"
    style={`background-image: url(${flowers.src});`}
  >
    <h3
      class="absolute z-5 font-display text-2xl leading-[3] tracking-tight text-white drop-shadow-[0_4px_20px_rgba(0,0,0,0.8)] md:text-4xl"
    >
      Liquid Space
    </h3>
  </div>

  <div
    class="absolute left-0 top-0 z-50 overflow-hidden opacity-0 transition-opacity duration-300 pointer-events-none will-change-transform w-(--cursor-size) h-(--cursor-size) rounded-(--cursor-radius)"
    id="liquid-cursor"
    style={`--cursor-size:${cursorSize}px; --cursor-radius:${cursorR}px;`}
  >
    <div
      id="cursor-content-clone"
      class="glass-clone-wrap rounded-(--cursor-radius)"
    >
      <div id="cursor-clone-inner" class="glass-clone-inner bg-[#050508]"></div>
    </div>

    <SvgFilter filterId={filterId} width={cursorSize} height={cursorSize} />

    <div
      class="glass-inner-overlay rounded-(--cursor-radius) border border-white/15 bg-white/3 shadow-[0_8px_20px_rgba(0,0,0,0.15),inset_0_4px_12px_rgba(255,255,255,0.2),inset_0_-4px_12px_rgba(0,0,0,0.5)]"
      id="cursor-inner"
    >
    </div>
  </div>
</div>

<script>
  import { Spring } from "@quarks/spring";
  import {
    applyLiquidAssets,
    bindLiquidControls,
    createLiquidAssets,
    syncCloneContent,
    updateLiquidFilter,
  } from "@quarks/liquidGlassEngine";

  class CursorExhibit {
    private demoArea: HTMLElement;
    private cursor: HTMLElement;
    private cursorInner: HTMLElement;
    private cloneInner: HTMLElement;
    private cloneWrapper: HTMLElement;
    private realWorld!: HTMLElement;
    private modal: HTMLElement | null;
    private modalPanel: HTMLElement | null;
    private modalSurface: HTMLElement | null;

    private config = { s: 90, r: 45, bw: 15, gt: 60, ri: 1.45, maxDisp: 0 };
    private controls = {
      idleScale: 1,
      hoverScale: 1.6,
      pressScale: 0.7,
      refraction: 1.5,
      blur: 0,
      specularOpacity: 0.75,
      saturation: 7,
    };
    private state = {
      mx: 250,
      my: 250,
      ih: false,
      ip: false,
      hm: false,
      modalOpen: false,
    };
    private springs = {
      x: new Spring(250, 400, 25),
      y: new Spring(250, 400, 25),
      sc: new Spring(1, 350, 20),
      sa: new Spring(0.15, 300, 20),
      bgx: new Spring(0, 220, 18),
      bgy: new Spring(0, 220, 18),
    };

    private af: number | null = null;

    constructor() {
      this.demoArea = document.getElementById(
        "cursor-demo-area",
      ) as HTMLElement;
      this.cursor = document.getElementById("liquid-cursor") as HTMLElement;
      this.cursorInner = document.getElementById("cursor-inner") as HTMLElement;
      this.cloneInner = document.getElementById(
        "cursor-clone-inner",
      ) as HTMLElement;
      this.cloneWrapper = document.getElementById(
        "cursor-content-clone",
      ) as HTMLElement;
      this.modal = document.getElementById("cursor-controls-modal");
      this.modalPanel = this.modal?.querySelector(
        "[data-cursor-modal-panel]",
      ) as HTMLElement | null;
      this.modalSurface = this.modal?.querySelector(
        "[data-modal-surface]",
      ) as HTMLElement | null;

      if (!this.cursor) return;
      this.init();
    }

    private init() {
      this.realWorld = document.getElementById(
        "cursor-real-world",
      ) as HTMLElement;
      syncCloneContent(this.cloneInner, this.realWorld);
      this.cloneWrapper.style.filter = "url(#cursor-glass-filter)";

      this.regenerate();
      this.syncFilterTuning();
      this.bindControls();
      this.bindModal();

      this.demoArea.addEventListener("mousemove", this.onMouseMove.bind(this));
      this.demoArea.addEventListener("mousedown", () => {
        this.state.ip = true;
        if (!this.af) this.af = requestAnimationFrame(this.loop);
      });
      this.demoArea.addEventListener("mouseup", () => {
        this.state.ip = false;
        if (!this.af) this.af = requestAnimationFrame(this.loop);
      });
      this.demoArea.addEventListener("mouseleave", () => {
        this.cursor.style.opacity = "0";
        this.state.hm = false;
        const rect = this.demoArea.getBoundingClientRect();
        this.state.mx = rect.width / 2;
        this.state.my = rect.height / 2;
      });
      this.demoArea.addEventListener("mouseenter", () => {
        if (this.state.hm) this.cursor.style.opacity = "1";
      });

      const btn = document.getElementById("cursorHoverBtn");
      if (btn) {
        btn.addEventListener("mouseenter", () => {
          this.state.ih = true;
          if (!this.af) this.af = requestAnimationFrame(this.loop);
        });
        btn.addEventListener("mouseleave", () => {
          this.state.ih = false;
          if (!this.af) this.af = requestAnimationFrame(this.loop);
        });
      }

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") this.setModal(false);
      });

      this.af = requestAnimationFrame(this.loop);
    }

    private bindControls() {
      bindLiquidControls(
        this.cursor,
        this.controls,
        () => {
          this.syncFilterTuning();
          if (!this.af) this.af = requestAnimationFrame(this.loop);
        },
        () => {
          Object.assign(this.controls, {
            idleScale: 1,
            hoverScale: 1.6,
            pressScale: 0.7,
            refraction: 1.5,
            blur: 0,
            specularOpacity: 0.75,
            saturation: 7,
          });
          this.syncFilterTuning();
          if (!this.af) this.af = requestAnimationFrame(this.loop);
        },
      );
    }

    private bindModal() {
      document
        .querySelector("[data-open-cursor-controls]")
        ?.addEventListener("click", () => {
          this.setModal(true);
        });
      this.modal
        ?.querySelector("[data-close-cursor-controls]")
        ?.addEventListener("click", () => {
          this.setModal(false);
        });
    }

    private setModal(open: boolean) {
      this.state.modalOpen = open;
      if (!this.modal || !this.modalPanel) return;
      const hiddenOffsetClass =
        this.modalPanel.dataset.modalOffsetClass ?? "translate-y-[0.75rem]";
      this.modal.classList.toggle("pointer-events-none", !open);
      this.modal.classList.toggle("opacity-0", !open);
      this.modalPanel.classList.toggle(hiddenOffsetClass, !open);
      this.modalSurface?.classList.toggle("pointer-events-auto", open);
      this.modalSurface?.classList.toggle("pointer-events-none", !open);
    }

    private regenerate() {
      const assets = createLiquidAssets({
        width: this.config.s,
        height: this.config.s,
        radius: this.config.r,
        bezelWidth: this.config.bw,
        glassThickness: this.config.gt,
        refractiveIndex: this.config.ri,
      });
      this.config.maxDisp = assets.maximumDisplacement;
      applyLiquidAssets("cursor-glass-filter", assets);
    }

    private syncFilterTuning() {
      updateLiquidFilter("cursor-glass-filter", {
        blurStdDev: this.controls.blur,
        saturation: this.controls.saturation,
        specularAlpha: this.controls.specularOpacity,
      });
    }

    private onMouseMove(e: MouseEvent) {
      const r = this.demoArea.getBoundingClientRect();
      this.state.mx = e.clientX - r.left;
      this.state.my = e.clientY - r.top;
      if (!this.state.hm) {
        this.state.hm = true;
        this.cursor.style.opacity = "1";
        this.springs.x.value = this.state.mx;
        this.springs.y.value = this.state.my;
      }
      if (!this.af) this.af = requestAnimationFrame(this.loop);
    }

    private loop = () => {
      const dt = Math.min(0.032, 1 / 60);
      const areaRect = this.demoArea.getBoundingClientRect();
      this.springs.x.setTarget(this.state.mx);
      this.springs.y.setTarget(this.state.my);
      this.springs.bgx.setTarget(
        (this.state.mx / Math.max(areaRect.width, 1) - 0.5) * 28,
      );
      this.springs.bgy.setTarget(
        (this.state.my / Math.max(areaRect.height, 1) - 0.5) * 28,
      );

      if (this.state.ip) {
        this.springs.sc.setTarget(this.controls.pressScale);
        this.springs.sa.setTarget(0.3);
      } else if (this.state.ih) {
        this.springs.sc.setTarget(this.controls.hoverScale);
        this.springs.sa.setTarget(0.1);
      } else {
        this.springs.sc.setTarget(this.controls.idleScale);
        this.springs.sa.setTarget(0.15);
      }

      const cx = this.springs.x.update(dt),
        cy = this.springs.y.update(dt),
        cs = this.springs.sc.update(dt),
        sa = this.springs.sa.update(dt),
        bgx = this.springs.bgx.update(dt),
        bgy = this.springs.bgy.update(dt);
      const ox = cx - this.config.s / 2;
      const oy = cy - this.config.s / 2;

      this.cursor.style.transform = `translate(${ox}px, ${oy}px) scale(${cs})`;
      this.cursorInner.style.boxShadow = `0 ${8 * cs}px ${20 * cs}px rgba(0,0,0,${sa}), inset 0 4px 12px rgba(255,255,255,0.2), inset 0 -4px 12px rgba(0,0,0,0.5)`;
      updateLiquidFilter("cursor-glass-filter", {
        scale: this.config.maxDisp * this.controls.refraction * cs,
      });

      this.cloneInner.style.width = areaRect.width + "px";
      this.cloneInner.style.height = areaRect.height + "px";
      this.cloneInner.style.transform = `scale(${1 / cs}) translate(${-ox}px, ${-oy}px)`;
      this.realWorld.style.backgroundPosition = `calc(50% + ${bgx}px) calc(50% + ${bgy}px)`;
      const clonedBgNode = this.cloneInner.firstElementChild as HTMLElement;
      if (clonedBgNode) {
        clonedBgNode.style.backgroundPosition = `calc(50% + ${bgx}px) calc(50% + ${bgy}px)`;
      }

      this.af = requestAnimationFrame(this.loop);
    };
  }

  document.addEventListener("DOMContentLoaded", () => {
    new CursorExhibit();
  });
</script>

<style>
  .cursor-real-world {
    background-size: 168%;
  }

  @media (min-width: 640px) {
    .cursor-real-world {
      background-size: 118%;
    }
  }
</style>
