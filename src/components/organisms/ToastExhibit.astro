---
import SvgFilter from "../atoms/SvgFilter.astro";

const filterId = "toast-glass-filter";
---

<div class="relative w-full h-full flex items-center justify-center p-8 bg-gray-50 dark:bg-[#0f0f0f] overflow-hidden" id="toast-demo-area">
  
  <div id="toast-real-world" class="absolute inset-0 pointer-events-none overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom,_var(--tw-gradient-stops))] from-gray-200 via-gray-100 to-transparent dark:from-gray-800 dark:via-gray-900"></div>
  </div>

  <SvgFilter filterId={filterId} />

  <div class="relative flex flex-col items-center gap-4 z-10">
    
    <button id="toast-trigger" class="px-6 py-2 bg-gray-900 dark:bg-white text-white dark:text-gray-900 text-sm font-bold rounded-full hover:scale-105 transition-transform">
      Show Notification
    </button>

    <div class="relative flex items-center gap-3 p-4 rounded-xl bg-white/80 dark:bg-black/80 backdrop-blur-xl border border-gray-200 dark:border-white/10 shadow-2xl min-w-[320px] hidden" id="toast-glass">
      <div id="toast-content-clone" class="absolute inset-0 overflow-hidden rounded-xl z-[1] will-change-filter" style={`filter: url(#${filterId})`}>
        <div id="toast-clone-inner" class="absolute top-0 left-0 pointer-events-none will-change-transform transform-gpu origin-top-left bg-gray-50 dark:bg-[#0f0f0f]">
        </div>
      </div>
      
      <div class="relative z-[2] flex-shrink-0 w-10 h-10 rounded-full bg-emerald-500 flex items-center justify-center shadow-lg">
        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
      </div>
      
      <div class="flex-1 min-w-0">
        <h4 class="text-sm font-bold text-gray-900 dark:text-white truncate">Update Complete</h4>
        <p class="text-xs text-gray-500 dark:text-gray-400 truncate">Your changes have been saved successfully.</p>
      </div>
      
      <button class="relative z-[2] text-gray-400 hover:text-gray-600 dark:hover:text-gray-200">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>
  </div>
</div>

<script>
  import { Spring } from "../../quarks/spring";
  import { SurfaceEquations } from "../../quarks/surfaceEquations";
  import { calculateDisplacementMap1D, calculateDisplacementMap2D, calculateSpecularHighlight, imageDataToDataURL } from "../../quarks/surfaceRenderer";

  class ToastExhibit {
    private trigger: HTMLElement;
    private glass: HTMLElement;
    private cloneInner: HTMLElement;
    private demoArea: HTMLElement;
    
    private config = { w: 340, h: 80, bw: 10, gt: 35, r: 12, ri: 1.6, maxDisp: 0 };
    private state = { visible: false, animating: false };
    
    private springs = {
      x: new Spring(0, 400, 30),
      scale: new Spring(0.9, 400, 25),
      opacity: new Spring(0, 300, 20),
      dispScale: new Spring(1, 300, 20)
    };
    
    private af: number | null = null;
    private hideTimeout: any = null;

    constructor() {
      this.trigger = document.getElementById('toast-trigger') as HTMLElement;
      this.glass = document.getElementById('toast-glass') as HTMLElement;
      this.cloneInner = document.getElementById('toast-clone-inner') as HTMLElement;
      this.demoArea = document.getElementById('toast-demo-area') as HTMLElement;

      if (!this.trigger) return;
      this.init();
    }

    private init() {
      const rw = document.getElementById('toast-real-world');
      if (rw) this.cloneInner.innerHTML = rw.outerHTML;

      const pc = calculateDisplacementMap1D(this.config.gt, this.config.bw, SurfaceEquations.convex_squircle, this.config.ri);
      this.config.maxDisp = Math.max(...pc.map(Math.abs));

      const dispData = calculateDisplacementMap2D(this.config.w, this.config.h, this.config.w, this.config.h, this.config.r, this.config.bw, this.config.maxDisp || 1, pc);
      const specData = calculateSpecularHighlight(this.config.w, this.config.h, this.config.r, this.config.bw);

      document.getElementById("toast-glass-filter-image")?.setAttribute("href", imageDataToDataURL(dispData));
      document.getElementById("toast-glass-filter-specular")?.setAttribute("href", imageDataToDataURL(specData));

      this.trigger.addEventListener('click', this.show.bind(this));
      
      const closeBtn = this.glass.querySelector('button:last-child');
      if (closeBtn) closeBtn.addEventListener('click', this.hide.bind(this));
      
      window.addEventListener('resize', this.updateClone.bind(this));
      this.updateClone();
      this.startLoop();
    }

    private show() {
      if (this.state.animating || this.state.visible) return;
      this.state.visible = true;
      this.state.animating = true;
      
      this.glass.classList.remove('hidden');
      this.springs.scale.setTarget(1);
      this.springs.opacity.setTarget(1);
      this.springs.x.setTarget(0);
      this.springs.dispScale.setTarget(1.5);
      
      clearTimeout(this.hideTimeout);
      this.hideTimeout = setTimeout(() => this.hide(), 4000);
      
      this.startLoop();
    }

    private hide() {
      if (!this.state.visible) return;
      this.state.animating = true;
      
      this.springs.scale.setTarget(0.9);
      this.springs.opacity.setTarget(0);
      this.springs.x.setTarget(50);
      this.springs.dispScale.setTarget(1);
      
      setTimeout(() => {
        this.state.visible = false;
        this.glass.classList.add('hidden');
      }, 300);
      
      this.startLoop();
    }

    private updateClone() {
      const aR = this.demoArea.getBoundingClientRect();
      const gR = this.glass.getBoundingClientRect();
      
      this.cloneInner.style.width = aR.width + "px";
      this.cloneInner.style.height = aR.height + "px";
      
      const sc = this.springs.scale.value;
      const ox = gR.left - aR.left;
      const oy = gR.top - aR.top;
      
      this.cloneInner.style.transform = `scale(${1/sc}) translate(${-ox * sc}px, ${-oy * sc}px)`;
    }

    private loop = () => {
      const dt = Math.min(0.032, 1 / 60);
      
      const x = this.springs.x.update(dt);
      const sc = this.springs.scale.update(dt);
      const op = this.springs.opacity.update(dt);
      const ds = this.springs.dispScale.update(dt);
      
      this.glass.style.transform = `translateX(${x}px) scale(${sc})`;
      this.glass.style.opacity = op;
      this.glass.style.pointerEvents = op > 0.1 ? 'auto' : 'none';
      
      document.getElementById("toast-glass-filter-map")?.setAttribute("scale", (this.config.maxDisp * ds).toString());

      this.updateClone();

      if (!Object.values(this.springs).every(s => s.isSettled())) {
        this.af = requestAnimationFrame(this.loop);
      } else {
        this.af = null;
      }
    };

    private startLoop() {
      if (!this.af) this.af = requestAnimationFrame(this.loop);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    new ToastExhibit();
  });
</script>