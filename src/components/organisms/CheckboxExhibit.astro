---
import SvgFilter from "../atoms/SvgFilter.astro";

const filterId = "checkbox-glass-filter";
const boxW = 64;
const boxH = 64;
const boxR = 24;
---

<div
  class="relative w-full h-full flex items-center justify-center p-8 bg-gray-50 dark:bg-[#0f0f0f]"
  id="checkbox-demo-area"
>
  <!-- Real World Background -->
  <div
    id="checkbox-real-world"
    class="absolute inset-0 pointer-events-none overflow-hidden"
  >
    <div
      class="absolute inset-0 bg-[linear-gradient(#e5e7eb_1px,transparent_1px),linear-gradient(90deg,#e5e7eb_1px,transparent_1px)] bg-size-[20px_20px] dark:bg-[linear-gradient(#262626_1px,transparent_1px),linear-gradient(90deg,#262626_1px,transparent_1px)] opacity-50"
    >
    </div>
    <div
      class="absolute w-[200px] h-[200px] bg-emerald-500/30 dark:bg-emerald-600/40 rounded-full blur-[60px] top-[10%] left-[10%]"
    >
    </div>
  </div>

  <SvgFilter filterId={filterId} width={boxW} height={boxH} />

  <!-- Checkbox Container -->
  <div
    class="relative flex items-center gap-6 cursor-pointer z-10"
    id="checkbox-container"
  >
    <!-- Box -->
    <div
      class="relative will-change-transform"
      id="checkbox-glass-box"
      style={`width: ${boxW}px; height: ${boxH}px; border-radius: ${boxR}px; overflow: hidden;`}
    >
      <div
        id="checkbox-content-clone"
        class="glass-clone-wrap"
        style={`border-radius: ${boxR}px;`}
      >
        <div
          id="checkbox-clone-inner"
          class="glass-clone-inner bg-gray-50 dark:bg-[#0f0f0f]"
        >
        </div>
      </div>

      <div
        class="glass-inner-overlay"
        id="checkbox-box-inner"
        style={`border-radius: ${boxR}px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.15); box-shadow: 0 10px 20px rgba(0,0,0,0.4), inset 0 2px 4px rgba(255,255,255,0.2);`}
      >
      </div>

      <!-- Checkmark Icon -->
      <svg
        class="absolute inset-0 w-full h-full p-4 z-5 text-emerald-400"
        id="checkbox-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="3"
        stroke-linecap="round"
        stroke-linejoin="round"
        style="opacity: 0; transform: scale(0.5); filter: drop-shadow(0 0 10px rgba(16, 185, 129, 0.5));"
      >
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
    </div>

    <!-- Label -->
    <span class="text-lg font-medium text-gray-900 dark:text-white select-none"
      >Accept Terms</span
    >
  </div>
</div>

<script>
  import { Spring } from "../../quarks/spring";
  import { SurfaceEquations } from "../../quarks/surfaceEquations";
  import {
    calculateDisplacementMap1D,
    calculateDisplacementMap2D,
    calculateSpecularHighlight,
    imageDataToDataURL,
  } from "../../quarks/surfaceRenderer";

  class CheckboxExhibit {
    private container: HTMLElement;
    private box: HTMLElement;
    private boxInner: HTMLElement;
    private icon: SVGElement;
    private cloneInner: HTMLElement;
    private cloneWrapper: HTMLElement;
    private demoArea: HTMLElement;

    private config = {
      w: 64,
      h: 64,
      bw: 16,
      gt: 60,
      r: 24,
      ri: 1.6,
      maxDisp: 0,
    };
    private state = { checked: false, isDown: false };

    private springs = {
      scale: new Spring(1, 400, 20),
      checkScale: new Spring(0, 500, 25),
      dispScale: new Spring(1, 300, 20),
    };

    private af: number | null = null;

    constructor() {
      this.container = document.getElementById(
        "checkbox-container",
      ) as HTMLElement;
      this.box = document.getElementById("checkbox-glass-box") as HTMLElement;
      this.boxInner = document.getElementById(
        "checkbox-box-inner",
      ) as HTMLElement;
      this.icon = document.getElementById(
        "checkbox-icon",
      ) as unknown as SVGElement;
      this.cloneInner = document.getElementById(
        "checkbox-clone-inner",
      ) as HTMLElement;
      this.cloneWrapper = document.getElementById(
        "checkbox-content-clone",
      ) as HTMLElement;
      this.demoArea = document.getElementById(
        "checkbox-demo-area",
      ) as HTMLElement;

      if (!this.container) return;
      this.init();
    }

    private init() {
      this.cloneInner.innerHTML =
        document.getElementById("checkbox-real-world")?.outerHTML || "";
      this.cloneWrapper.style.filter = "url(#checkbox-glass-filter)";

      const pc = calculateDisplacementMap1D(
        this.config.gt,
        this.config.bw,
        SurfaceEquations.convex_squircle,
        this.config.ri,
      );
      this.config.maxDisp = Math.max(...pc.map(Math.abs));

      const dispData = calculateDisplacementMap2D(
        this.config.w,
        this.config.h,
        this.config.w,
        this.config.h,
        this.config.r,
        this.config.bw,
        this.config.maxDisp || 1,
        pc,
      );
      const specData = calculateSpecularHighlight(
        this.config.w,
        this.config.h,
        this.config.r,
        this.config.bw,
      );

      document
        .getElementById("checkbox-glass-filter-image")
        ?.setAttribute("href", imageDataToDataURL(dispData));
      document
        .getElementById("checkbox-glass-filter-specular")
        ?.setAttribute("href", imageDataToDataURL(specData));

      this.container.addEventListener("click", this.toggle.bind(this));
      this.box.addEventListener("mousedown", () => {
        this.state.isDown = true;
        this.startLoop();
      });
      this.box.addEventListener("mouseup", () => {
        this.state.isDown = false;
        this.startLoop();
      });
      this.box.addEventListener("touchstart", (e) => {
        e.preventDefault();
        this.state.isDown = true;
        this.startLoop();
      });
      this.box.addEventListener("touchend", () => {
        this.state.isDown = false;
        this.startLoop();
      });

      window.addEventListener("resize", this.updateClone.bind(this));

      this.updateClone();
      this.startLoop();
    }

    private toggle() {
      this.state.checked = !this.state.checked;

      if (this.state.checked) {
        this.springs.checkScale.setTarget(1);
        (this.icon as any).style.opacity = "1";
        (this.icon as any).style.transform = "scale(1)";
        this.boxInner.style.background = "rgba(16, 185, 129, 0.3)";
        this.boxInner.style.borderColor = "rgba(16, 185, 129, 0.6)";
      } else {
        this.springs.checkScale.setTarget(0);
        (this.icon as any).style.opacity = "0";
        (this.icon as any).style.transform = "scale(0.5)";
        this.boxInner.style.background = "rgba(255, 255, 255, 0.05)";
        this.boxInner.style.borderColor = "rgba(255, 255, 255, 0.15)";
      }

      this.springs.scale.setTarget(1.15);
      setTimeout(() => this.springs.scale.setTarget(1), 100);
      this.startLoop();
    }

    private updateClone() {
      const aR = this.demoArea.getBoundingClientRect();
      const boxRect = this.box.getBoundingClientRect();

      this.cloneInner.style.width = aR.width + "px";
      this.cloneInner.style.height = aR.height + "px";

      const sc = this.springs.scale.value;
      const offsetX = boxRect.left - aR.left;
      const offsetY = boxRect.top - aR.top;

      this.cloneInner.style.transform = `scale(${1 / sc}) translate(${-offsetX * sc}px, ${-offsetY * sc}px)`;
    }

    private loop = () => {
      const dt = Math.min(0.032, 1 / 60);

      const sc = this.springs.scale.update(dt);
      const cs = this.springs.checkScale.update(dt);
      const ds = this.springs.dispScale.update(dt);

      this.box.style.transform = `scale(${sc})`;

      document
        .getElementById("checkbox-glass-filter-map")
        ?.setAttribute("scale", (this.config.maxDisp * ds).toString());

      this.updateClone();

      if (!Object.values(this.springs).every((s) => s.isSettled())) {
        this.af = requestAnimationFrame(this.loop);
      } else {
        this.af = null;
      }
    };

    private startLoop() {
      if (!this.af) this.af = requestAnimationFrame(this.loop);
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    new CheckboxExhibit();
  });
</script>
