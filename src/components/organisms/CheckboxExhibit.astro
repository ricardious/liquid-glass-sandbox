---
import SvgFilter from "../atoms/SvgFilter.astro";

const filterId = "checkbox-glass-filter";
---

<div class="relative w-full h-full flex items-center justify-center p-8 bg-gray-50 dark:bg-[#0f0f0f]" id="checkbox-demo-area">
  
  <!-- Real World Background -->
  <div id="checkbox-real-world" class="absolute inset-0 pointer-events-none overflow-hidden">
    <div class="absolute inset-0 bg-[linear-gradient(#e5e7eb_1px,transparent_1px),linear-gradient(90deg,#e5e7eb_1px,transparent_1px)] bg-[size:20px_20px] dark:bg-[linear-gradient(#262626_1px,transparent_1px),linear-gradient(90deg,#262626_1px,transparent_1px)] opacity-50"></div>
    <div class="absolute w-48 h-48 bg-pink-500/10 dark:bg-pink-600/20 rounded-full blur-3xl mix-blend-multiply top-10 right-10"></div>
  </div>

  <SvgFilter filterId={filterId} />

  <!-- Checkbox Container -->
  <div class="relative flex items-center gap-6 cursor-pointer z-10" id="checkbox-container">
    
    <!-- Box -->
    <div 
      class="relative w-10 h-10 will-change-transform"
      id="checkbox-glass-box"
    >
      <div id="checkbox-content-clone" class="absolute inset-0 overflow-hidden rounded-lg z-[1] will-change-filter" style={`filter: url(#${filterId})`}>
        <div id="checkbox-clone-inner" class="absolute top-0 left-0 pointer-events-none will-change-transform transform-gpu origin-top-left bg-gray-50 dark:bg-[#0f0f0f]">
        </div>
      </div>
      <div class="absolute inset-0 z-[2] rounded-lg border border-gray-300 dark:border-white/30 bg-white/20 dark:bg-white/10 shadow-[0_4px_12px_rgba(0,0,0,0.1),inset_0_2px_4px_rgba(255,255,255,0.8)] pointer-events-none transition-shadow" id="checkbox-box-inner"></div>
      
      <!-- Checkmark Icon -->
      <svg class="absolute inset-0 w-full h-full p-2 z-[3] opacity-0 transition-all duration-300 transform scale-50 text-white" id="checkbox-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
    </div>

    <!-- Label -->
    <span class="text-lg font-medium text-gray-900 dark:text-white select-none">Accept Terms</span>
  </div>
</div>

<script>
  import { Spring } from "../../quarks/spring";
  import { SurfaceEquations } from "../../quarks/surfaceEquations";
  import { calculateDisplacementMap1D, calculateDisplacementMap2D, calculateSpecularHighlight, imageDataToDataURL } from "../../quarks/surfaceRenderer";

  class CheckboxExhibit {
    private container: HTMLElement;
    private box: HTMLElement;
    private boxInner: HTMLElement;
    private icon: HTMLElement;
    private cloneInner: HTMLElement;
    private demoArea: HTMLElement;
    
    private config = { w: 44, h: 44, bw: 8, gt: 40, r: 8, ri: 1.5, maxDisp: 0 };
    private state = { checked: false, isDown: false };
    
    private springs = {
      scale: new Spring(1, 400, 20),
      checkScale: new Spring(0, 300, 25),
      dispScale: new Spring(1, 300, 20)
    };
    
    private af: number | null = null;

    constructor() {
      this.container = document.getElementById('checkbox-container') as HTMLElement;
      this.box = document.getElementById('checkbox-glass-box') as HTMLElement;
      this.boxInner = document.getElementById('checkbox-box-inner') as HTMLElement;
      this.icon = document.getElementById('checkbox-icon') as HTMLElement;
      this.cloneInner = document.getElementById('checkbox-clone-inner') as HTMLElement;
      this.demoArea = document.getElementById('checkbox-demo-area') as HTMLElement;

      if (!this.container) return;
      this.init();
    }

    private init() {
      this.cloneInner.innerHTML = document.getElementById('checkbox-real-world')?.outerHTML || '';

      const pc = calculateDisplacementMap1D(this.config.gt, this.config.bw, SurfaceEquations.convex_squircle, this.config.ri);
      this.config.maxDisp = Math.max(...pc.map(Math.abs));

      const dispData = calculateDisplacementMap2D(this.config.w, this.config.h, this.config.w, this.config.h, this.config.r, this.config.bw, this.config.maxDisp || 1, pc);
      const specData = calculateSpecularHighlight(this.config.w, this.config.h, this.config.r, this.config.bw);

      document.getElementById("checkbox-glass-filter-image")?.setAttribute("href", imageDataToDataURL(dispData));
      document.getElementById("checkbox-glass-filter-specular")?.setAttribute("href", imageDataToDataURL(specData));

      this.container.addEventListener('click', this.toggle.bind(this));
      this.box.addEventListener('mousedown', () => { this.state.isDown = true; this.startLoop(); });
      this.box.addEventListener('mouseup', () => { this.state.isDown = false; this.startLoop(); });
      
      window.addEventListener('resize', this.updateClone.bind(this));
      
      this.updateClone();
      this.startLoop();
    }

    private toggle() {
      this.state.checked = !this.state.checked;
      
      if (this.state.checked) {
        this.springs.scale.setTarget(1.15);
        this.springs.checkScale.setTarget(1);
        this.icon.classList.remove('opacity-0', 'scale-50');
        this.icon.classList.add('opacity-100', 'scale-100');
        this.boxInner.classList.add('bg-blue-500', 'border-blue-500');
        this.boxInner.classList.remove('bg-white/20');
      } else {
        this.springs.scale.setTarget(1);
        this.springs.checkScale.setTarget(0);
        this.icon.classList.add('opacity-0', 'scale-50');
        this.icon.classList.remove('opacity-100', 'scale-100');
        this.boxInner.classList.remove('bg-blue-500', 'border-blue-500');
        this.boxInner.classList.add('bg-white/20');
      }
      
      setTimeout(() => this.springs.scale.setTarget(1), 100);
      this.startLoop();
    }

    private updateClone() {
      const aR = this.demoArea.getBoundingClientRect();
      const boxRect = this.box.getBoundingClientRect();
      
      this.cloneInner.style.width = aR.width + "px";
      this.cloneInner.style.height = aR.height + "px";
      
      const sc = this.springs.scale.value;
      const offsetX = boxRect.left - aR.left;
      const offsetY = boxRect.top - aR.top;
      
      this.cloneInner.style.transform = `scale(${1/sc}) translate(${-offsetX * sc}px, ${-offsetY * sc}px)`;
    }

    private loop = () => {
      const dt = Math.min(0.032, 1 / 60);
      
      const sc = this.springs.scale.update(dt);
      const cs = this.springs.checkScale.update(dt);
      const ds = this.springs.dispScale.update(dt);
      
      this.box.style.transform = `scale(${sc})`;
      
      if (this.state.isDown) {
        this.boxInner.style.boxShadow = '0 2px 8px rgba(0,0,0,0.2), inset 0 1px 2px rgba(255,255,255,0.9)';
      } else {
        this.boxInner.style.boxShadow = '0 4px 12px rgba(0,0,0,0.1), inset 0 2px 4px rgba(255,255,255,0.8)';
      }
      
      document.getElementById("checkbox-glass-filter-map")?.setAttribute("scale", (this.config.maxDisp * ds).toString());

      this.updateClone();

      if (!Object.values(this.springs).every(s => s.isSettled())) {
        this.af = requestAnimationFrame(this.loop);
      } else {
        this.af = null;
      }
    };

    private startLoop() {
      if (!this.af) this.af = requestAnimationFrame(this.loop);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    new CheckboxExhibit();
  });
</script>