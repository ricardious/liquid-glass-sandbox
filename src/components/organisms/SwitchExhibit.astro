---
import backgroundImage from "@assets/tropical-floral-pattern-dark.webp";
import SvgFilter from "@components/atoms/SvgFilter.astro";

const filterId = "switch-glass-filter";
const trackW = 160;
const trackH = 67;
const thumbW = 146;
const thumbH = 92;
const thumbR = 46;
---

<div
  class="relative h-full w-full flex items-center justify-center p-4 sm:p-8 bg-gray-50 dark:bg-[#0f0f0f]"
  id="switch-demo-shell"
>
  <div
    class="relative w-full max-w-5xl aspect-video sm:aspect-21/9 min-h-[320px] overflow-hidden rounded-3xl shadow-2xl border border-black/5 dark:border-white/10"
    id="switch-demo-area"
  >
    <div
      id="switch-real-world"
      class="switch-background absolute inset-0 pointer-events-none overflow-hidden bg-[#0b1016] bg-cover bg-center"
      style={`background-image: url(${backgroundImage.src});`}
    >
      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(255,255,255,0.16),transparent_24%),radial-gradient(circle_at_80%_30%,rgba(255,255,255,0.12),transparent_22%),linear-gradient(180deg,rgba(7,12,18,0.08),rgba(8,12,16,0.52))]"
      >
      </div>
    </div>

    <div class="relative flex h-full w-full items-center justify-center">
      <div
        id="liquid-switch-container"
        data-controls="switch-controls"
        class="relative z-10 cursor-pointer rounded-full p-2 shadow-[inset_0_2px_10px_rgba(0,0,0,0.3)]"
        style={`width: ${trackW}px; height: ${trackH}px; background: rgba(148,148,159,0.47);`}
      >
        <div
          id="liquid-switch-thumb"
          class="absolute left-0 top-1/2 z-10 touch-none will-change-transform"
          style={`width: ${thumbW}px; height: ${thumbH}px; border-radius: ${thumbR}px; transform-origin: center center;`}
        >
          <div class="pointer-events-none absolute inset-0 overflow-hidden rounded-[inherit]">
            <div id="switch-content-clone" class="glass-clone-wrap absolute inset-0 rounded-[inherit] opacity-0">
              <div id="switch-clone-inner" class="switch-clone-inner glass-clone-inner bg-gray-50 dark:bg-[#0f0f0f]"></div>
            </div>
          </div>

          <SvgFilter
            filterId={filterId}
            width={thumbW}
            height={thumbH}
            blurStdDev={0.2}
            saturation={6}
            specularAlpha={0.5}
            mode="control"
          />

          <div id="switch-thumb-inner" class="glass-inner-overlay rounded-[inherit] shadow-[0_4px_22px_rgba(0,0,0,0.1)]"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .switch-background {
    transform: scale(1.08);
    animation: switchBgFloat 22s ease-in-out infinite alternate;
  }

  @keyframes switchBgFloat {
    from {
      transform: scale(1.08) translate3d(-2%, -1%, 0);
    }

    to {
      transform: scale(1.14) translate3d(2%, 2%, 0);
    }
  }
</style>

<script>
  import { Spring } from "@quarks/spring";
  import {
    applyLiquidAssets,
    bindLiquidControls,
    createLiquidAssets,
    syncCloneContent,
    updateLiquidFilter,
  } from "@quarks/liquidGlassEngine";

  class SwitchExhibit {
    private container: HTMLElement;
    private thumb: HTMLElement;
    private inner: HTMLElement;
    private cloneInner: HTMLElement;
    private cloneTrack: HTMLDivElement | null = null;
    private demoArea: HTMLElement;
    private realWorld!: HTMLElement;
    private cloneWrapper: HTMLElement;
    private modal: HTMLElement | null;
    private modalPanel: HTMLElement | null;
    private modalSurface: HTMLElement | null;

    private readonly config = {
      trackW: 160,
      trackH: 67,
      thumbW: 146,
      thumbH: 92,
      thumbR: 46,
      bezelWidth: 19,
      glassThickness: 47,
      refractiveIndex: 1.5,
      restScale: 0.65,
      activeScale: 0.9,
    };

    private controls = {
      forceActive: false,
      refraction: 1,
      blur: 0.2,
      specularOpacity: 0.5,
      saturation: 6,
    };

    private state = {
      checked: false,
      pointerDown: false,
      startX: 0,
      xDragRatio: 0,
      maxDisp: 0,
      modalOpen: false,
    };

    private springs = {
      xRatio: new Spring(0, 1000, 80),
      scale: new Spring(0.65, 2000, 80),
      bgOpacity: new Spring(1, 2000, 80),
      trackColor: new Spring(0, 1000, 80),
      dispScale: new Spring(0.4, 100, 10),
    };

    private af: number | null = null;

    constructor() {
      this.container = document.getElementById("liquid-switch-container") as HTMLElement;
      this.thumb = document.getElementById("liquid-switch-thumb") as HTMLElement;
      this.inner = document.getElementById("switch-thumb-inner") as HTMLElement;
      this.cloneInner = document.getElementById("switch-clone-inner") as HTMLElement;
      this.demoArea = document.getElementById("switch-demo-area") as HTMLElement;
      this.realWorld = document.getElementById("switch-real-world") as HTMLElement;
      this.cloneWrapper = document.getElementById("switch-content-clone") as HTMLElement;
      this.modal = document.getElementById("switch-controls-modal");
      this.modalPanel = this.modal?.querySelector(
        "[data-switch-modal-panel]",
      ) as HTMLElement | null;
      this.modalSurface = this.modal?.querySelector(
        "[data-modal-surface]",
      ) as HTMLElement | null;

      if (!this.container) return;
      this.init();
    }

    private init() {
      syncCloneContent(this.cloneInner, this.realWorld);
      this.mountCloneTrack();
      this.cloneWrapper.style.filter = "url(#switch-glass-filter)";

      const assets = createLiquidAssets({
        width: this.config.thumbW,
        height: this.config.thumbH,
        radius: this.config.thumbR,
        bezelWidth: this.config.bezelWidth,
        glassThickness: this.config.glassThickness,
        refractiveIndex: this.config.refractiveIndex,
      });

      this.state.maxDisp = assets.maximumDisplacement;
      applyLiquidAssets("switch-glass-filter", assets);
      this.syncFilterTuning();
      this.bindControls();
      this.bindModal();

      this.thumb.addEventListener("pointerdown", this.onPointerDown.bind(this));
      window.addEventListener("pointermove", this.onPointerMove.bind(this));
      window.addEventListener("pointerup", this.onPointerUp.bind(this));
      this.container.addEventListener("click", (event) => {
        if (event.target === this.container) {
          this.state.checked = !this.state.checked;
          this.startLoop();
        }
      });
      window.addEventListener("resize", this.startLoop.bind(this));
      this.startLoop();
    }

    private bindControls() {
      bindLiquidControls(
        this.container,
        this.controls,
        () => {
          this.syncFilterTuning();
          this.startLoop();
        },
        () => {
          Object.assign(this.controls, {
            forceActive: false,
            refraction: 1,
            blur: 0.2,
            specularOpacity: 0.5,
            saturation: 6,
          });
          this.syncFilterTuning();
          this.startLoop();
        },
      );
    }

    private mountCloneTrack() {
      this.cloneTrack?.remove();
      const track = document.createElement("div");
      track.className = "switch-clone-track";
      this.cloneInner.append(track);
      this.cloneTrack = track;
    }

    private bindModal() {
      document
        .querySelector("[data-open-switch-controls]")
        ?.addEventListener("click", () => {
          this.setModal(true);
        });
      this.modal
        ?.querySelector("[data-close-switch-controls]")
        ?.addEventListener("click", () => {
          this.setModal(false);
        });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") this.setModal(false);
      });
    }

    private setModal(open: boolean) {
      this.state.modalOpen = open;
      if (!this.modal || !this.modalPanel) return;
      const hiddenOffsetClass =
        this.modalPanel.dataset.modalOffsetClass ?? "translate-y-[0.75rem]";
      this.modal.classList.toggle("pointer-events-none", !open);
      this.modal.classList.toggle("opacity-0", !open);
      this.modalPanel.classList.toggle(hiddenOffsetClass, !open);
      this.modalSurface?.classList.toggle("pointer-events-auto", open);
      this.modalSurface?.classList.toggle("pointer-events-none", !open);
    }

    private syncFilterTuning() {
      updateLiquidFilter("switch-glass-filter", {
        blurStdDev: this.controls.blur,
        saturation: this.controls.saturation,
        specularAlpha: this.controls.specularOpacity,
      });
    }

    private get restOffset() {
      return ((1 - this.config.restScale) * this.config.thumbW) / 2;
    }

    private get travel() {
      return this.config.trackW - this.config.trackH - (this.config.thumbW - this.config.thumbH) * this.config.restScale;
    }

    private onPointerDown(event: PointerEvent) {
      event.preventDefault();
      event.stopPropagation();
      this.state.pointerDown = true;
      this.state.startX = event.clientX;
      this.state.xDragRatio = this.state.checked ? 1 : 0;
      this.startLoop();
    }

    private onPointerMove(event: PointerEvent) {
      if (!this.state.pointerDown) return;
      event.stopPropagation();

      const displacementX = event.clientX - this.state.startX;
      const baseRatio = this.state.checked ? 1 : 0;
      const rawRatio = baseRatio + displacementX / this.travel;
      const overflow = rawRatio < 0 ? -rawRatio : rawRatio > 1 ? rawRatio - 1 : 0;
      const overflowSign = rawRatio < 0 ? -1 : 1;
      this.state.xDragRatio = Math.min(1, Math.max(0, rawRatio)) + (overflowSign * overflow) / 22;
      this.springs.xRatio.setTarget(this.state.xDragRatio);
      this.startLoop();
    }

    private onPointerUp(event: PointerEvent) {
      if (!this.state.pointerDown) return;
      this.state.pointerDown = false;

      const distance = Math.abs(event.clientX - this.state.startX);
      this.state.checked = distance < 4 ? !this.state.checked : this.state.xDragRatio > 0.5;
      this.startLoop();
    }

    private loop = () => {
      const dt = Math.min(0.032, 1 / 60);
      const isActive = this.state.pointerDown || this.controls.forceActive;

      this.springs.scale.setTarget(isActive ? this.config.activeScale : this.config.restScale);
      this.springs.bgOpacity.setTarget(isActive ? 0.1 : 1);
      this.springs.dispScale.setTarget((isActive ? 0.9 : 0.4) * this.controls.refraction);

      if (!this.state.pointerDown) {
        this.springs.xRatio.setTarget(this.state.checked ? 1 : 0);
      }

      const considerChecked = this.state.pointerDown ? (this.state.xDragRatio > 0.5 ? 1 : 0) : this.state.checked ? 1 : 0;
      this.springs.trackColor.setTarget(considerChecked);

      const xRatio = this.springs.xRatio.update(dt);
      const scale = this.springs.scale.update(dt);
      const bgOpacity = this.springs.bgOpacity.update(dt);
      const trackColor = this.springs.trackColor.update(dt);
      const dispScale = this.springs.dispScale.update(dt);

      const cloneOpacity = 1 - bgOpacity;
      this.cloneWrapper.style.opacity = cloneOpacity.toString();

      const marginLeft = -this.restOffset + (this.config.trackH - this.config.thumbH * this.config.restScale) / 2;
      const thumbX = marginLeft + xRatio * this.travel;
      this.thumb.style.left = `${thumbX}px`;
      this.thumb.style.transform = `translateY(-50%) scale(${scale})`;
      this.thumb.style.backgroundColor = `rgba(255,255,255,${bgOpacity})`;
      this.inner.style.boxShadow = this.state.pointerDown
        ? "0 4px 22px rgba(0,0,0,0.1), inset 2px 7px 24px rgba(0,0,0,0.09), inset -2px -7px 24px rgba(255,255,255,0.09)"
        : "0 4px 22px rgba(0,0,0,0.1)";

      const offR = 148;
      const offG = 148;
      const offB = 159;
      const offA = 0.47;
      const onR = 59;
      const onG = 191;
      const onB = 78;
      const onA = 0.93;
      const trackBgColor = `rgba(${Math.round(offR + (onR - offR) * trackColor)}, ${Math.round(offG + (onG - offG) * trackColor)}, ${Math.round(offB + (onB - offB) * trackColor)}, ${offA + (onA - offA) * trackColor})`;
      this.container.style.backgroundColor = trackBgColor;

      const areaRect = this.demoArea.getBoundingClientRect();
      const containerLeft = (areaRect.width - this.config.trackW) / 2;
      const containerTop = (areaRect.height - this.config.trackH) / 2;
      const thumbYOffset = this.config.trackH / 2 - this.config.thumbH / 2;

      this.cloneInner.style.width = `${areaRect.width}px`;
      this.cloneInner.style.height = `${areaRect.height}px`;
      this.cloneInner.style.transform = `translate(${-(containerLeft + thumbX)}px, ${-(containerTop + thumbYOffset)}px)`;
      this.cloneInner.style.setProperty("--switch-track-color", trackBgColor);
      this.cloneInner.style.setProperty("--track-left", `${containerLeft}px`);
      this.cloneInner.style.setProperty("--track-top", `${containerTop}px`);
      this.cloneInner.style.setProperty("--track-width", `${this.config.trackW}px`);
      this.cloneInner.style.setProperty("--track-height", `${this.config.trackH}px`);
      if (this.cloneTrack) {
        this.cloneTrack.style.left = `${containerLeft}px`;
        this.cloneTrack.style.top = `${containerTop}px`;
        this.cloneTrack.style.width = `${this.config.trackW}px`;
        this.cloneTrack.style.height = `${this.config.trackH}px`;
        this.cloneTrack.style.backgroundColor = trackBgColor;
      }

      updateLiquidFilter("switch-glass-filter", {
        scale: this.state.maxDisp * dispScale,
      });

      if (!Object.values(this.springs).every((spring) => spring.isSettled())) {
        this.af = requestAnimationFrame(this.loop);
      } else {
        this.af = null;
      }
    };

    private startLoop() {
      if (!this.af) this.af = requestAnimationFrame(this.loop);
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    new SwitchExhibit();
  });
</script>
