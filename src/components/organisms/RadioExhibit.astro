---
import SvgFilter from "../atoms/SvgFilter.astro";

const filterId = "radio-glass-filter";
---

<div class="relative w-full h-full flex items-center justify-center p-8 bg-gray-50 dark:bg-[#0f0f0f]" id="radio-demo-area">
  
  <div id="radio-real-world" class="absolute inset-0 pointer-events-none overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] dark:bg-[radial-gradient(#262626_1px,transparent_1px)] [background-size:16px_16px]"></div>
    <div class="absolute w-full h-full bg-gradient-to-b from-transparent to-gray-100/50 dark:to-gray-900/50"></div>
  </div>

  <SvgFilter filterId={filterId} />

  <div class="relative flex items-center justify-center gap-2 z-10" id="radio-container">
    
    {['S', 'M', 'L'].map((size, i) => (
      <div class="relative w-12 h-12 will-change-transform cursor-pointer group" data-index={i}>
        <div class="radio-content-clone absolute inset-0 overflow-hidden rounded-full z-[1] will-change-filter" style={`filter: url(#${filterId})`}>
          <div class="radio-clone-inner absolute top-0 left-0 pointer-events-none will-change-transform transform-gpu origin-top-left bg-gray-50 dark:bg-[#0f0f0f]">
          </div>
        </div>
        
        <div class="radio-thumb-inner absolute inset-0 z-[2] rounded-full border border-gray-300 dark:border-white/30 bg-white/10 dark:bg-white/5 shadow-[0_4px_12px_rgba(0,0,0,0.1),inset_0_2px_4px_rgba(255,255,255,0.8)] pointer-events-none transition-colors group-hover:bg-white/20 dark:group-hover:bg-white/10"></div>
        
        <span class="absolute inset-0 z-[3] flex items-center justify-center text-sm font-bold text-gray-900 dark:text-white">{size}</span>
      </div>
    ))}

  </div>
</div>

<script>
  import { Spring } from "../../quarks/spring";
  import { SurfaceEquations } from "../../quarks/surfaceEquations";
  import { calculateDisplacementMap1D, calculateDisplacementMap2D, calculateSpecularHighlight, imageDataToDataURL } from "../../quarks/surfaceRenderer";

  class RadioExhibit {
    private container: HTMLElement;
    private options: HTMLElement[];
    private clones: HTMLElement[];
    private demoArea: HTMLElement;
    
    private config = { w: 48, h: 48, bw: 8, gt: 30, r: 24, ri: 1.6, maxDisp: 0 };
    private state = { activeIndex: 1 };
    
    private springs: Spring[] = [];
    private af: number | null = null;

    constructor() {
      this.container = document.getElementById('radio-container') as HTMLElement;
      this.options = Array.from(this.container.querySelectorAll('[data-index]'));
      this.demoArea = document.getElementById('radio-demo-area') as HTMLElement;
      this.clones = Array.from(this.container.querySelectorAll('.radio-clone-inner'));

      if (!this.container) return;
      this.init();
    }

    private init() {
      const rw = document.getElementById('radio-real-world');
      if (rw) this.clones.forEach(c => c.innerHTML = rw.outerHTML);

      const pc = calculateDisplacementMap1D(this.config.gt, this.config.bw, SurfaceEquations.convex_squircle, this.config.ri);
      this.config.maxDisp = Math.max(...pc.map(Math.abs));

      const dispData = calculateDisplacementMap2D(this.config.w, this.config.h, this.config.w, this.config.h, this.config.r, this.config.bw, this.config.maxDisp || 1, pc);
      const specData = calculateSpecularHighlight(this.config.w, this.config.h, this.config.r, this.config.bw);

      document.getElementById("radio-glass-filter-image")?.setAttribute("href", imageDataToDataURL(dispData));
      document.getElementById("radio-glass-filter-specular")?.setAttribute("href", imageDataToDataURL(specData));

      this.options.forEach((opt, i) => {
        this.springs.push(new Spring(i === 1 ? 1.15 : 1, 400, 25)); // M is active on init
        
        opt.addEventListener('click', () => this.select(i));
        opt.addEventListener('mouseenter', () => {
          if (i !== this.state.activeIndex) this.startSpring(i, 1.1);
          this.startLoop();
        });
        opt.addEventListener('mouseleave', () => {
          if (i !== this.state.activeIndex) this.startSpring(i, 1);
          this.startLoop();
        });
      });
      
      window.addEventListener('resize', this.updateClones.bind(this));
      
      this.updateClones();
      this.startLoop();
    }

    private select(index: number) {
      this.state.activeIndex = index;
      
      this.options.forEach((_, i) => {
        const target = i === index ? 1.15 : 1;
        this.springs[i].setTarget(target);
      });
      
      this.startLoop();
    }

    private startSpring(index: number, target: number) {
      this.springs[index].setTarget(target);
    }

    private updateClones() {
      const aR = this.demoArea.getBoundingClientRect();
      
      this.options.forEach((opt, i) => {
        const clone = this.clones[i];
        const r = opt.getBoundingClientRect();
        
        clone.style.width = aR.width + "px";
        clone.style.height = aR.height + "px";
        
        const sc = this.springs[i].value;
        const ox = r.left - aR.left;
        const oy = r.top - aR.top;
        
        clone.style.transform = `scale(${1/sc}) translate(${-ox * sc}px, ${-oy * sc}px)`;
      });
    }

    private loop = () => {
      const dt = Math.min(0.032, 1 / 60);
      
      this.springs.forEach((s, i) => {
        const sc = s.update(dt);
        this.options[i].style.transform = `scale(${sc})`;
        
        const inner = this.options[i].querySelector('.radio-thumb-inner') as HTMLElement;
        if (i === this.state.activeIndex) {
          inner.classList.add('bg-blue-500/20', 'border-blue-500');
          inner.classList.remove('bg-white/10');
        } else {
          inner.classList.remove('bg-blue-500/20', 'border-blue-500');
          inner.classList.add('bg-white/10');
        }
      });
      
      document.getElementById("radio-glass-filter-map")?.setAttribute("scale", (this.config.maxDisp * 1.2).toString());
      this.updateClones();

      if (!this.springs.every(s => s.isSettled())) {
        this.af = requestAnimationFrame(this.loop);
      } else {
        this.af = null;
      }
    };

    private startLoop() {
      if (!this.af) this.af = requestAnimationFrame(this.loop);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    new RadioExhibit();
  });
</script>