---
import flowers from "@assets/botanical-bloom-pattern-teal.webp";
import SvgFilter from "@components/atoms/SvgFilter.astro";

const filterId = "card-glass-filter";
const desktopCardW = 388;
const desktopCardH = 236;
---

<style>
  .card-demo-root {
    --card-width: 288px;
    --card-height: 186px;
    --card-radius: 16px;
    --card-padding: 0.95rem;
    --card-logo-size: 30px;
    --card-heading-indent: 0.75rem;
    --card-label-size: 11px;
    --card-number-size: 18px;
    --card-field-size: 12px;
    --card-field-gap: 0.75rem;
    --card-exp-width: 64px;
    --card-ccv-width: 48px;
  }

  @media (min-width: 640px) {
    .card-demo-root {
      --card-width: 388px;
      --card-height: 236px;
      --card-radius: 20px;
      --card-padding: 1.5rem;
      --card-logo-size: 42px;
      --card-heading-indent: 1.5rem;
      --card-label-size: 12px;
      --card-number-size: 26px;
      --card-field-size: 16px;
      --card-field-gap: 1.5rem;
      --card-exp-width: 80px;
      --card-ccv-width: 60px;
    }
  }

  .cc-input {
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .cc-input::placeholder {
    color: rgba(255, 255, 255, 0.55);
  }

  .cc-input:hover,
  .cc-input:focus {
    border-bottom-color: rgba(255, 255, 255, 0.95);
  }
</style>

<div
  class="card-demo-root relative flex min-h-[600px] w-full flex-col items-center justify-center overflow-hidden rounded-2xl p-4 sm:p-8"
  id="card-demo-area"
>
  <div
    id="card-real-world"
    class="absolute inset-4 pointer-events-none overflow-hidden rounded-3xl bg-[#071015] sm:inset-8"
  >
    <div
      data-card-bg-layer
      class="absolute inset-[-10%] bg-cover bg-center will-change-transform"
      style={`background-image: url(${flowers.src});`}
    >
    </div>
    <div
      class="absolute inset-0 bg-[linear-gradient(180deg,rgba(5,10,14,0.48),rgba(0,0,0,0.74))]"
    >
    </div>
  </div>

  <div class="z-10 flex w-(--card-width) max-w-full flex-col px-1 sm:px-4">
    <h1
      class="mb-3 pl-(--card-heading-indent) font-body text-[15px] font-normal leading-[1.4] text-white sm:mb-4 sm:text-[20px]"
    >
      Please enter your credit card <br />details below
    </h1>

    <div
      class="relative cursor-pointer will-change-transform"
      id="liquid-card-container"
      style="width: var(--card-width); height: var(--card-height); border-radius: var(--card-radius);"
    >
      <div
        class="pointer-events-none absolute inset-0 overflow-hidden rounded-[inherit]"
      >
        <div
          id="card-content-clone"
          class="glass-clone-wrap absolute inset-0 rounded-[inherit]"
        >
          <div id="card-clone-inner" class="glass-clone-inner absolute inset-0">
          </div>
        </div>
      </div>

      <SvgFilter filterId={filterId} width={desktopCardW} height={desktopCardH} />

      <div
        id="card-thumb-inner"
        class="glass-inner-overlay absolute inset-0 flex flex-col justify-between rounded-[inherit] border-2 border-white/10 bg-white/10 p-(--card-padding) shadow-[0_0_80px_rgba(0,0,0,0.25)]"
      >
        <div class="mb-3 opacity-90">
          <svg width="var(--card-logo-size)" height="var(--card-logo-size)" viewBox="0 0 64 64" aria-hidden="true">
            <g fill="#FFFFFF">
              <circle cx="16" cy="16" r="16"></circle>
              <circle cx="16" cy="48" r="16"></circle>
              <circle cx="48" cy="16" r="16"></circle>
              <circle cx="48" cy="48" r="16"></circle>
            </g>
          </svg>
        </div>

        <form class="relative z-20 w-full">
          <div class="mb-3 sm:mb-6">
            <label class="mb-1 block font-body text-(length:--card-label-size) text-white"
              >Card Number</label
            >
            <input
              id="card-number"
              class="cc-input h-9 w-full border-0 border-b-2 border-white/15 bg-transparent px-0 font-body text-(length:--card-number-size) tracking-[0.14em] text-white outline-none sm:h-11 sm:tracking-widest"
              placeholder="1234 1234 1234 1234"
              type="text"
              required
              maxlength="19"
            />
          </div>

          <div class="flex gap-(--card-field-gap)">
            <div class="min-w-0 flex-1">
              <label class="mb-1 block font-body text-(length:--card-label-size) text-white"
                >Card Holder</label
              >
              <input
                id="card-name"
                class="cc-input h-[26px] w-full border-0 border-b-2 border-white/15 bg-transparent px-0 font-body text-(length:--card-field-size) tracking-[0.06em] text-white outline-none sm:h-[30px]"
                placeholder="RICARDIOUS"
                type="text"
                required
              />
            </div>
            <div class="w-(--card-exp-width)">
              <label class="mb-1 block font-body text-(length:--card-label-size) text-white"
                >Exp. Date</label
              >
              <input
                id="card-exp"
                class="cc-input h-[26px] w-full border-0 border-b-2 border-white/15 bg-transparent px-0 font-body text-(length:--card-field-size) tracking-[0.06em] text-white outline-none sm:h-[30px]"
                placeholder="24/26"
                type="text"
                maxlength="5"
                required
              />
            </div>
            <div class="w-(--card-ccv-width)">
              <label class="mb-1 block font-body text-(length:--card-label-size) text-white"
                >CCV</label
              >
              <input
                id="card-ccv"
                class="cc-input h-[26px] w-full border-0 border-b-2 border-white/15 bg-transparent px-0 font-body text-(length:--card-field-size) tracking-[0.06em] text-white outline-none sm:h-[30px]"
                placeholder="123"
                type="text"
                maxlength="3"
                required
              />
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  import { Spring } from "@quarks/spring";
  import {
    applyLiquidAssets,
    bindLiquidControls,
    createLiquidAssets,
    syncCloneContent,
    updateLiquidFilter,
  } from "@quarks/liquidGlassEngine";

  class CreditCardExhibit {
    private static readonly MOBILE_BREAKPOINT = 640;
    private container: HTMLElement;
    private cloneInner: HTMLElement;
    private demoArea: HTMLElement;
    private realWorld!: HTMLElement;
    private cloneWrapper: HTMLElement;
    private bgLayer: HTMLElement;
    private cloneBgLayer: HTMLElement | null = null;
    private modal: HTMLElement | null;
    private modalPanel: HTMLElement | null;
    private modalSurface: HTMLElement | null;

    private config = {
      w: 0,
      h: 0,
      bw: 30,
      gt: 80,
      r: 0,
      ri: 1.45,
      maxDisp: 0,
    };
    private controls = {
      hoverScale: 1.02,
      refraction: 0.5,
      tilt: 0.05,
      blur: 0,
      specularOpacity: 0.6,
      saturation: 1.2,
    };

    private af: number | null = null;
    private scaleSpring = new Spring(1, 200, 20);
    private rotXSpring = new Spring(0, 150, 15);
    private rotYSpring = new Spring(0, 150, 15);
    private bgXSpring = new Spring(0, 160, 16);
    private bgYSpring = new Spring(0, 160, 16);
    private bgScaleSpring = new Spring(1.08, 160, 16);

    constructor() {
      this.container = document.getElementById(
        "liquid-card-container",
      ) as HTMLElement;
      this.cloneInner = document.getElementById(
        "card-clone-inner",
      ) as HTMLElement;
      this.demoArea = document.getElementById("card-demo-area") as HTMLElement;
      this.realWorld = document.getElementById(
        "card-real-world",
      ) as HTMLElement;
      this.bgLayer = this.realWorld.querySelector(
        "[data-card-bg-layer]",
      ) as HTMLElement;
      this.cloneWrapper = document.getElementById(
        "card-content-clone",
      ) as HTMLElement;
      this.modal = document.getElementById("card-controls-modal");
      this.modalPanel = this.modal?.querySelector(
        "[data-card-modal-panel]",
      ) as HTMLElement | null;
      this.modalSurface = this.modal?.querySelector(
        "[data-modal-surface]",
      ) as HTMLElement | null;

      if (!this.container) return;
      this.init();
      this.initInputs();
    }

    private init() {
      syncCloneContent(this.cloneInner, this.realWorld);
      this.cloneBgLayer = this.cloneInner.querySelector(
        "[data-card-bg-layer]",
      ) as HTMLElement | null;
      this.cloneWrapper.style.filter = "url(#card-glass-filter)";
      this.applyResponsiveConfig();
      this.regenerate();
      this.syncFilterTuning();
      this.bindControls();
      this.bindModal();

      this.container.addEventListener("mousemove", (e) => {
        const rect = this.container.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;
        this.rotYSpring.setTarget(x * this.controls.tilt);
        this.rotXSpring.setTarget(-y * this.controls.tilt);
        this.bgXSpring.setTarget(-x * 0.045);
        this.bgYSpring.setTarget(-y * 0.045);
        this.startLoop();
      });

      this.container.addEventListener("mouseenter", () => {
        this.scaleSpring.setTarget(this.controls.hoverScale);
        this.bgScaleSpring.setTarget(1.14);
        this.startLoop();
      });

      this.container.addEventListener("mouseleave", () => {
        this.scaleSpring.setTarget(1);
        this.rotXSpring.setTarget(0);
        this.rotYSpring.setTarget(0);
        this.bgXSpring.setTarget(0);
        this.bgYSpring.setTarget(0);
        this.bgScaleSpring.setTarget(1.08);
        this.startLoop();
      });

      window.addEventListener("resize", this.handleResize);
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") this.setModal(false);
      });

      this.updateClone();
      this.startLoop();
    }

    private getResponsiveConfig() {
      if (window.innerWidth < CreditCardExhibit.MOBILE_BREAKPOINT) {
        return {
          w: 288,
          h: 186,
          r: 16,
        };
      }

      return {
        w: 388,
        h: 236,
        r: 20,
      };
    }

    private applyResponsiveConfig() {
      const nextConfig = this.getResponsiveConfig();

      if (
        this.config.w === nextConfig.w &&
        this.config.h === nextConfig.h &&
        this.config.r === nextConfig.r
      ) {
        return;
      }

      Object.assign(this.config, nextConfig);
      this.container.style.width = `${this.config.w}px`;
      this.container.style.height = `${this.config.h}px`;
      this.container.style.borderRadius = `${this.config.r}px`;

      const image = document.getElementById("card-glass-filter-image");
      const specular = document.getElementById("card-glass-filter-specular");
      image?.setAttribute("width", String(this.config.w));
      image?.setAttribute("height", String(this.config.h));
      specular?.setAttribute("width", String(this.config.w));
      specular?.setAttribute("height", String(this.config.h));
    }

    private regenerate() {
      const assets = createLiquidAssets({
        width: this.config.w,
        height: this.config.h,
        radius: this.config.r,
        bezelWidth: this.config.bw,
        glassThickness: this.config.gt,
        refractiveIndex: this.config.ri,
      });

      this.config.maxDisp = assets.maximumDisplacement;
      applyLiquidAssets("card-glass-filter", assets);
    }

    private handleResize = () => {
      const previous = {
        w: this.config.w,
        h: this.config.h,
        r: this.config.r,
      };

      this.applyResponsiveConfig();

      if (
        previous.w !== this.config.w ||
        previous.h !== this.config.h ||
        previous.r !== this.config.r
      ) {
        this.regenerate();
      }

      this.updateClone();
      this.startLoop();
    };

    private bindControls() {
      bindLiquidControls(
        this.container,
        this.controls,
        () => {
          this.syncFilterTuning();
          this.startLoop();
        },
        () => {
          Object.assign(this.controls, {
            hoverScale: 1.02,
            refraction: 0.5,
            tilt: 0.05,
            blur: 0,
            specularOpacity: 0.6,
            saturation: 1.2,
          });
          this.syncFilterTuning();
          this.startLoop();
        },
      );
    }

    private syncFilterTuning() {
      updateLiquidFilter("card-glass-filter", {
        scale: this.config.maxDisp * this.controls.refraction,
        blurStdDev: this.controls.blur,
        saturation: this.controls.saturation,
        specularAlpha: this.controls.specularOpacity,
      });
    }

    private bindModal() {
      document
        .querySelector("[data-open-card-controls]")
        ?.addEventListener("click", () => {
          this.setModal(true);
        });
      this.modal
        ?.querySelector("[data-close-card-controls]")
        ?.addEventListener("click", () => {
          this.setModal(false);
        });
    }

    private setModal(open: boolean) {
      if (!this.modal || !this.modalPanel) return;
      const hiddenOffsetClass =
        this.modalPanel.dataset.modalOffsetClass ?? "translate-y-[0.75rem]";
      this.modal.classList.toggle("pointer-events-none", !open);
      this.modal.classList.toggle("opacity-0", !open);
      this.modalPanel.classList.toggle(hiddenOffsetClass, !open);
      this.modalSurface?.classList.toggle("pointer-events-auto", open);
      this.modalSurface?.classList.toggle("pointer-events-none", !open);
    }

    private initInputs() {
      const cardNumber = document.getElementById(
        "card-number",
      ) as HTMLInputElement;
      const cardExp = document.getElementById("card-exp") as HTMLInputElement;

      if (cardNumber) {
        cardNumber.addEventListener("input", (e) => {
          let val = (e.target as HTMLInputElement).value;
          val = val
            .replace(/[^a-z0-9]+/gi, "")
            .replace(/(.{4})/g, "$1 ")
            .trim();
          (e.target as HTMLInputElement).value = val;
        });
      }

      if (cardExp) {
        cardExp.addEventListener("input", (e) => {
          let val = (e.target as HTMLInputElement).value;
          val = val.replace(/[^0-9]+/gi, "");
          if (val.length > 2) {
            val = val.substring(0, 2) + "/" + val.substring(2);
          }
          (e.target as HTMLInputElement).value = val;
        });
      }
    }

    private updateClone() {
      const areaRect = this.demoArea.getBoundingClientRect();

      this.cloneInner.style.width = areaRect.width + "px";
      this.cloneInner.style.height = areaRect.height + "px";

      const scale = this.scaleSpring.value;
      const offsetX = this.container.offsetLeft;
      const offsetY = this.container.offsetTop;

      this.cloneInner.style.transform = `scale(${1 / scale}) translate(${-offsetX * scale}px, ${-offsetY * scale}px)`;
    }

    private loop = () => {
      const dt = Math.min(0.032, 1 / 60);

      const scale = this.scaleSpring.update(dt);
      const rx = this.rotXSpring.update(dt);
      const ry = this.rotYSpring.update(dt);
      const bgX = this.bgXSpring.update(dt);
      const bgY = this.bgYSpring.update(dt);
      const bgScale = this.bgScaleSpring.update(dt);

      this.container.style.transform = `perspective(1000px) scale(${scale}) rotateX(${rx}deg) rotateY(${ry}deg)`;
      const bgTransform = `translate3d(${bgX}px, ${bgY}px, 0) scale(${bgScale})`;
      this.bgLayer.style.transform = bgTransform;
      if (this.cloneBgLayer) this.cloneBgLayer.style.transform = bgTransform;

      this.updateClone();

      if (
        !this.scaleSpring.isSettled() ||
        !this.rotXSpring.isSettled() ||
        !this.rotYSpring.isSettled() ||
        !this.bgXSpring.isSettled() ||
        !this.bgYSpring.isSettled() ||
        !this.bgScaleSpring.isSettled()
      ) {
        this.af = requestAnimationFrame(this.loop);
      } else {
        this.af = null;
      }
    };

    private startLoop() {
      if (!this.af) this.af = requestAnimationFrame(this.loop);
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    new CreditCardExhibit();
  });
</script>
