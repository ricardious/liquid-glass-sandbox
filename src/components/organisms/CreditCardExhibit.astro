---
import flowers from "@assets/succulent-seamless.webp";
import SvgFilter from "@components/atoms/SvgFilter.astro";

const filterId = "card-glass-filter";
const cardW = 388;
const cardH = 236;
const cardR = 20;
---

<style>
  .cc-input {
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .cc-input::placeholder {
    color: rgba(255, 255, 255, 0.55);
  }

  .cc-input:hover,
  .cc-input:focus {
    border-bottom-color: rgba(255, 255, 255, 0.95);
  }
</style>

<div
  class="relative flex min-h-[600px] w-full flex-col items-center justify-center overflow-hidden rounded-2xl p-4 sm:p-8"
  id="card-demo-area"
>
  <div
    id="card-real-world"
    class="absolute inset-4 pointer-events-none overflow-hidden rounded-3xl bg-[#071015] bg-cover bg-center sm:inset-8"
    style={`background-image: url(${flowers.src});`}
  >
    <div
      class="absolute inset-0 bg-[linear-gradient(180deg,rgba(5,10,14,0.48),rgba(0,0,0,0.74))]"
    >
    </div>
  </div>

  <div class="z-10 flex w-[388px] max-w-full flex-col px-2 sm:px-4">
    <h1
      class="mb-4 pl-6 font-body text-[18px] font-normal leading-[1.45] text-white sm:text-[20px]"
    >
      Please enter your credit card <br />details below
    </h1>

    <div
      class="relative cursor-pointer will-change-transform"
      id="liquid-card-container"
      style={`width: ${cardW}px; height: ${cardH}px; border-radius: ${cardR}px;`}
    >
      <div
        class="pointer-events-none absolute inset-0 overflow-hidden rounded-[20px]"
      >
        <div
          id="card-content-clone"
          class="glass-clone-wrap absolute inset-0 rounded-[20px]"
        >
          <div id="card-clone-inner" class="glass-clone-inner absolute inset-0">
          </div>
        </div>
      </div>

      <SvgFilter filterId={filterId} width={cardW} height={cardH} />

      <div
        id="card-thumb-inner"
        class="glass-inner-overlay absolute inset-0 flex flex-col justify-between rounded-[20px] border-2 border-white/10 bg-white/10 p-6 shadow-[0_0_80px_rgba(0,0,0,0.25)]"
      >
        <div class="mb-3 opacity-90">
          <svg width="42" height="42" viewBox="0 0 64 64" aria-hidden="true">
            <g fill="#FFFFFF">
              <circle cx="16" cy="16" r="16"></circle>
              <circle cx="16" cy="48" r="16"></circle>
              <circle cx="48" cy="16" r="16"></circle>
              <circle cx="48" cy="48" r="16"></circle>
            </g>
          </svg>
        </div>

        <form class="relative z-20 w-full">
          <div class="mb-6">
            <label class="mb-1 block font-body text-[12px] text-white"
              >Card Number</label
            >
            <input
              id="card-number"
              class="cc-input h-11 w-full border-0 border-b-2 border-white/15 bg-transparent px-0 font-body text-[26px] tracking-widest text-white outline-none"
              placeholder="1234 1234 1234 1234"
              type="text"
              required
              maxlength="19"
            />
          </div>

          <div class="flex gap-6">
            <div class="min-w-0 flex-1">
              <label class="mb-1 block font-body text-[12px] text-white"
                >Card Holder</label
              >
              <input
                id="card-name"
                class="cc-input h-[30px] w-full border-0 border-b-2 border-white/15 bg-transparent px-0 font-body text-[16px] tracking-[0.08em] text-white outline-none"
                placeholder="RICARDIOUS"
                type="text"
                required
              />
            </div>
            <div class="w-[80px]">
              <label class="mb-1 block font-body text-[12px] text-white"
                >Exp. Date</label
              >
              <input
                id="card-exp"
                class="cc-input h-[30px] w-full border-0 border-b-2 border-white/15 bg-transparent px-0 font-body text-[16px] tracking-[0.08em] text-white outline-none"
                placeholder="24/26"
                type="text"
                maxlength="5"
                required
              />
            </div>
            <div class="w-[60px]">
              <label class="mb-1 block font-body text-[12px] text-white"
                >CCV</label
              >
              <input
                id="card-ccv"
                class="cc-input h-[30px] w-full border-0 border-b-2 border-white/15 bg-transparent px-0 font-body text-[16px] tracking-[0.08em] text-white outline-none"
                placeholder="123"
                type="text"
                maxlength="3"
                required
              />
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  import { Spring } from "@quarks/spring";
  import {
    applyLiquidAssets,
    bindLiquidControls,
    createLiquidAssets,
    syncCloneContent,
    updateLiquidFilter,
  } from "@quarks/liquidGlassEngine";

  class CreditCardExhibit {
    private container: HTMLElement;
    private cloneInner: HTMLElement;
    private demoArea: HTMLElement;
    private realWorld!: HTMLElement;
    private cloneWrapper: HTMLElement;
    private modal: HTMLElement | null;
    private modalPanel: HTMLElement | null;
    private modalSurface: HTMLElement | null;

    private config = {
      w: 388,
      h: 236,
      bw: 30,
      gt: 80,
      r: 20,
      ri: 1.45,
      maxDisp: 0,
    };
    private controls = {
      hoverScale: 1.02,
      refraction: 0.5,
      tilt: 0.05,
      blur: 0,
      specularOpacity: 0.6,
      saturation: 1.2,
    };

    private af: number | null = null;
    private scaleSpring = new Spring(1, 200, 20);
    private rotXSpring = new Spring(0, 150, 15);
    private rotYSpring = new Spring(0, 150, 15);

    constructor() {
      this.container = document.getElementById(
        "liquid-card-container",
      ) as HTMLElement;
      this.cloneInner = document.getElementById(
        "card-clone-inner",
      ) as HTMLElement;
      this.demoArea = document.getElementById("card-demo-area") as HTMLElement;
      this.realWorld = document.getElementById(
        "card-real-world",
      ) as HTMLElement;
      this.cloneWrapper = document.getElementById(
        "card-content-clone",
      ) as HTMLElement;
      this.modal = document.getElementById("card-controls-modal");
      this.modalPanel = this.modal?.querySelector(
        "[data-card-modal-panel]",
      ) as HTMLElement | null;
      this.modalSurface = this.modal?.querySelector(
        "[data-modal-surface]",
      ) as HTMLElement | null;

      if (!this.container) return;
      this.init();
      this.initInputs();
    }

    private init() {
      syncCloneContent(this.cloneInner, this.realWorld);
      this.cloneWrapper.style.filter = "url(#card-glass-filter)";

      const assets = createLiquidAssets({
        width: this.config.w,
        height: this.config.h,
        radius: this.config.r,
        bezelWidth: this.config.bw,
        glassThickness: this.config.gt,
        refractiveIndex: this.config.ri,
      });

      this.config.maxDisp = assets.maximumDisplacement;
      applyLiquidAssets("card-glass-filter", assets);
      this.syncFilterTuning();
      this.bindControls();
      this.bindModal();

      this.container.addEventListener("mousemove", (e) => {
        const rect = this.container.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;
        this.rotYSpring.setTarget(x * this.controls.tilt);
        this.rotXSpring.setTarget(-y * this.controls.tilt);
        this.startLoop();
      });

      this.container.addEventListener("mouseenter", () => {
        this.scaleSpring.setTarget(this.controls.hoverScale);
        this.startLoop();
      });

      this.container.addEventListener("mouseleave", () => {
        this.scaleSpring.setTarget(1);
        this.rotXSpring.setTarget(0);
        this.rotYSpring.setTarget(0);
        this.startLoop();
      });

      window.addEventListener("resize", this.updateClone.bind(this));
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") this.setModal(false);
      });

      this.updateClone();
      this.startLoop();
    }

    private bindControls() {
      bindLiquidControls(
        this.container,
        this.controls,
        () => {
          this.syncFilterTuning();
          this.startLoop();
        },
        () => {
          Object.assign(this.controls, {
            hoverScale: 1.02,
            refraction: 0.5,
            tilt: 0.05,
            blur: 0,
            specularOpacity: 0.6,
            saturation: 1.2,
          });
          this.syncFilterTuning();
          this.startLoop();
        },
      );
    }

    private syncFilterTuning() {
      updateLiquidFilter("card-glass-filter", {
        scale: this.config.maxDisp * this.controls.refraction,
        blurStdDev: this.controls.blur,
        saturation: this.controls.saturation,
        specularAlpha: this.controls.specularOpacity,
      });
    }

    private bindModal() {
      document
        .querySelector("[data-open-card-controls]")
        ?.addEventListener("click", () => {
          this.setModal(true);
        });
      this.modal
        ?.querySelector("[data-close-card-controls]")
        ?.addEventListener("click", () => {
          this.setModal(false);
        });
    }

    private setModal(open: boolean) {
      if (!this.modal || !this.modalPanel) return;
      const hiddenOffsetClass =
        this.modalPanel.dataset.modalOffsetClass ?? "translate-y-[0.75rem]";
      this.modal.classList.toggle("pointer-events-none", !open);
      this.modal.classList.toggle("opacity-0", !open);
      this.modalPanel.classList.toggle(hiddenOffsetClass, !open);
      this.modalSurface?.classList.toggle("pointer-events-auto", open);
      this.modalSurface?.classList.toggle("pointer-events-none", !open);
    }

    private initInputs() {
      const cardNumber = document.getElementById(
        "card-number",
      ) as HTMLInputElement;
      const cardExp = document.getElementById("card-exp") as HTMLInputElement;

      if (cardNumber) {
        cardNumber.addEventListener("input", (e) => {
          let val = (e.target as HTMLInputElement).value;
          val = val
            .replace(/[^a-z0-9]+/gi, "")
            .replace(/(.{4})/g, "$1 ")
            .trim();
          (e.target as HTMLInputElement).value = val;
        });
      }

      if (cardExp) {
        cardExp.addEventListener("input", (e) => {
          let val = (e.target as HTMLInputElement).value;
          val = val.replace(/[^0-9]+/gi, "");
          if (val.length > 2) {
            val = val.substring(0, 2) + "/" + val.substring(2);
          }
          (e.target as HTMLInputElement).value = val;
        });
      }
    }

    private updateClone() {
      const areaRect = this.demoArea.getBoundingClientRect();

      this.cloneInner.style.width = areaRect.width + "px";
      this.cloneInner.style.height = areaRect.height + "px";

      const scale = this.scaleSpring.value;
      const offsetX = this.container.offsetLeft;
      const offsetY = this.container.offsetTop;

      this.cloneInner.style.transform = `scale(${1 / scale}) translate(${-offsetX * scale}px, ${-offsetY * scale}px)`;
    }

    private loop = () => {
      const dt = Math.min(0.032, 1 / 60);

      const scale = this.scaleSpring.update(dt);
      const rx = this.rotXSpring.update(dt);
      const ry = this.rotYSpring.update(dt);

      this.container.style.transform = `perspective(1000px) scale(${scale}) rotateX(${rx}deg) rotateY(${ry}deg)`;

      this.updateClone();

      if (
        !this.scaleSpring.isSettled() ||
        !this.rotXSpring.isSettled() ||
        !this.rotYSpring.isSettled()
      ) {
        this.af = requestAnimationFrame(this.loop);
      } else {
        this.af = null;
      }
    };

    private startLoop() {
      if (!this.af) this.af = requestAnimationFrame(this.loop);
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    new CreditCardExhibit();
  });
</script>
