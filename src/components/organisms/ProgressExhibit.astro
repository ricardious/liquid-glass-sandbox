---
import SvgFilter from "../atoms/SvgFilter.astro";

const filterId = "progress-glass-filter";
const barH = 48;
const barR = 24;
---

<div
  class="relative w-full h-full flex flex-col items-center justify-center p-8 bg-[#0a0a0f]"
  id="progress-demo-area"
>
  <div
    id="progress-real-world"
    class="absolute inset-0 pointer-events-none overflow-hidden"
  >
    <!-- Sleek background grid -->
    <div
      class="absolute inset-0 opacity-20"
      style="background-image: linear-gradient(rgba(255,255,255,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.05) 1px, transparent 1px); background-size: 20px 20px;"
    >
    </div>

    <!-- Empty track background (dimmed) -->
    <div
      id="progress-track-bg"
      class="absolute bg-white/5 rounded-full"
      style={`width: 384px; height: ${barH}px; box-shadow: inset 0 2px 10px rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.05);`}
    >
    </div>

    <!-- The actual liquid progress -->
    <div
      id="progress-liquid-bar"
      class="absolute bg-linear-to-r from-indigo-500 via-purple-500 to-pink-500 rounded-full"
      style={`height: ${barH}px; width: 0px; box-shadow: 0 0 20px rgba(236,72,153,0.6);`}
    >
    </div>

    <!-- The glowing leading edge -->
    <div
      id="progress-glow"
      class="absolute w-[80px] h-[80px] bg-pink-400 rounded-full blur-[20px] opacity-80 mix-blend-screen"
      style="transform: translate(-50%, -50%);"
    >
    </div>
  </div>

  <SvgFilter filterId={filterId} width={400} height={barH} />

  <!-- The Glass Container -->
  <div
    id="progress-wrapper"
    class="relative z-10 will-change-transform flex items-center"
    style={`width: 384px; height: ${barH}px; justify-content: flex-start;`}
  >
    <div
      id="progress-container"
      class="relative"
      style={`width: 48px; height: ${barH}px; border-radius: ${barR}px;`}
    >
      <div
        class="absolute inset-0 pointer-events-none"
        style={`border-radius: ${barR}px; overflow: hidden;`}
      >
        <div
          id="progress-content-clone"
          class="glass-clone-wrap absolute inset-0"
          style={`border-radius: ${barR}px;`}
        >
          <!-- The clone inner now has the colored liquid glow behind the glass! -->
          <div
            id="progress-clone-inner"
            class="glass-clone-inner absolute inset-0"
          >
          </div>
        </div>
      </div>

      <div
        class="glass-inner-overlay absolute inset-0 z-2 pointer-events-none"
        style={`border-radius: ${barR}px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.2); box-shadow: 0 10px 30px rgba(0,0,0,0.5), inset 0 2px 5px rgba(255,255,255,0.4), inset 0 0 20px rgba(255,255,255,0.1);`}
      >
      </div>

      <div
        id="progress-specular-img"
        class="absolute inset-0 pointer-events-none opacity-100 mix-blend-screen z-3"
        style={`border-radius: ${barR}px;`}
      >
      </div>
    </div>

    <div
      class="absolute inset-0 z-5 flex items-center justify-center pointer-events-none"
    >
      <span
        class="text-sm font-bold text-white drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)] tracking-wider"
        id="progress-text">0%</span
      >
    </div>
  </div>

  <button
    id="progress-trigger"
    class="mt-16 px-8 py-3 text-white text-sm font-bold rounded-full hover:scale-105 transition-transform relative z-20"
    style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.2); box-shadow: 0 8px 32px rgba(0,0,0,0.3); backdrop-filter: blur(10px);"
    >Simulate Load</button
  >
</div>

<script>
  import { Spring } from "../../quarks/spring";
  import { SurfaceEquations } from "../../quarks/surfaceEquations";
  import {
    calculateDisplacementMap1D,
    calculateDisplacementMap2D,
    calculateSpecularHighlight,
    imageDataToDataURL,
  } from "../../quarks/surfaceRenderer";

  class ProgressExhibit {
    private container: HTMLElement;
    private trackBg: HTMLElement;
    private liquidBar: HTMLElement;
    private liquidGlow: HTMLElement;
    private clonedLiquidBar: HTMLElement | null = null;
    private clonedLiquidGlow: HTMLElement | null = null;
    private text: HTMLElement;
    private trigger: HTMLElement;
    private cloneInner: HTMLElement;
    private cloneWrapper: HTMLElement;
    private demoArea: HTMLElement;

    private config = {
      w: 48,
      h: 48,
      bw: 16,
      gt: 100,
      r: 24,
      ri: 2.2,
      maxDisp: 0,
    };
    private state = { progress: 0, isAnimating: false };

    private springs = {
      progress: new Spring(0, 300, 30),
    };

    private af: number | null = null;
    private lastW: number = -1;

    constructor() {
      this.container = document.getElementById(
        "progress-container",
      ) as HTMLElement;
      this.trackBg = document.getElementById(
        "progress-track-bg",
      ) as HTMLElement;
      this.liquidBar = document.getElementById(
        "progress-liquid-bar",
      ) as HTMLElement;
      this.liquidGlow = document.getElementById("progress-glow") as HTMLElement;
      this.text = document.getElementById("progress-text") as HTMLElement;
      this.trigger = document.getElementById("progress-trigger") as HTMLElement;
      this.cloneInner = document.getElementById(
        "progress-clone-inner",
      ) as HTMLElement;
      this.cloneWrapper = document.getElementById(
        "progress-content-clone",
      ) as HTMLElement;
      this.demoArea = document.getElementById(
        "progress-demo-area",
      ) as HTMLElement;

      if (!this.container) return;
      this.init();
    }

    private init() {
      const rw = document.getElementById("progress-real-world");
      if (rw) {
        this.cloneInner.innerHTML = rw.outerHTML;
        this.clonedLiquidBar = this.cloneInner.querySelector(
          "#progress-liquid-bar",
        );
        this.clonedLiquidGlow = this.cloneInner.querySelector("#progress-glow");
      }
      this.cloneWrapper.style.filter = "url(#progress-glass-filter)";

      this.renderOptics();

      this.trigger.addEventListener("click", this.animate.bind(this));
      window.addEventListener("resize", () => {
        this.alignRealWorldElements();
        this.updateClone();
      });

      this.alignRealWorldElements();
      this.updateClone();
      this.startLoop();
    }

    private renderOptics() {
      const intW = Math.max(48, Math.round(this.config.w));
      const intH = Math.round(this.config.h);

      if (intW === this.lastW) return;
      this.lastW = intW;

      const pc = calculateDisplacementMap1D(
        this.config.gt,
        this.config.bw,
        SurfaceEquations.convex_squircle,
        this.config.ri,
      );
      this.config.maxDisp = Math.max(...pc.map(Math.abs));

      const dispData = calculateDisplacementMap2D(
        intW,
        intH,
        intW,
        intH,
        this.config.r,
        this.config.bw,
        this.config.maxDisp || 1,
        pc,
      );
      const specData = calculateSpecularHighlight(
        intW,
        intH,
        this.config.r,
        this.config.bw,
      );

      const filterImg = document.getElementById("progress-glass-filter-image");
      if (filterImg) {
        filterImg.setAttribute("href", imageDataToDataURL(dispData));
        filterImg.setAttribute("x", "0");
        filterImg.setAttribute("y", "0");
        filterImg.setAttribute("width", "100%");
        filterImg.setAttribute("height", "100%");
        filterImg.setAttribute("preserveAspectRatio", "none");
      }

      const specImg = document.getElementById("progress-specular-img");
      if (specImg) {
        specImg.style.backgroundImage = `url(${imageDataToDataURL(specData)})`;
        specImg.style.backgroundSize = "100% 100%";
      }
    }

    private alignRealWorldElements() {
      const wrapper = document.getElementById("progress-wrapper")!;
      const cR = wrapper.getBoundingClientRect();
      const aR = this.demoArea.getBoundingClientRect();
      const left = cR.left - aR.left;
      const top = cR.top - aR.top;

      this.trackBg.style.left = left + "px";
      this.trackBg.style.top = top + "px";

      this.liquidBar.style.left = left + "px";
      this.liquidBar.style.top = top + "px";

      this.liquidGlow.style.top = top + this.config.h / 2 + "px";
    }

    private animate() {
      if (this.state.isAnimating) return;
      this.state.isAnimating = true;

      const target = 10 + Math.random() * 90;
      this.springs.progress.setTarget(target);

      setTimeout(() => {
        this.state.isAnimating = false;
        if (Math.random() > 0.5) this.animate();
      }, 500);

      this.startLoop();
    }

    private updateClone() {
      const aR = this.demoArea.getBoundingClientRect();
      const cR = this.container.getBoundingClientRect();

      this.cloneInner.style.width = aR.width + "px";
      this.cloneInner.style.height = aR.height + "px";

      const offsetX = cR.left - aR.left;
      const offsetY = cR.top - aR.top;

      this.cloneInner.style.transform = `translate(${-offsetX}px, ${-offsetY}px)`;
    }

    private loop = () => {
      const dt = Math.min(0.032, 1 / 60);

      const p = this.springs.progress.update(dt);

      const maxW = 384;
      const progressW = (p / 100) * maxW;

      this.liquidBar.style.width = `${progressW}px`;
      if (this.clonedLiquidBar)
        this.clonedLiquidBar.style.width = `${progressW}px`;

      const wrapper = document.getElementById("progress-wrapper")!;
      const left =
        wrapper.getBoundingClientRect().left -
        this.demoArea.getBoundingClientRect().left;
      this.liquidGlow.style.left = `${left + progressW}px`;
      if (this.clonedLiquidGlow)
        this.clonedLiquidGlow.style.left = `${left + progressW}px`;

      const pixelWidth = Math.max(48, progressW);
      this.config.w = pixelWidth;
      this.container.style.width = `${pixelWidth}px`;

      this.text.innerText = `${Math.round(p)}%`;

      const velocity = this.springs.progress.velocity;
      const ds = 1 + Math.abs(velocity) * 0.003;
      document
        .getElementById("progress-glass-filter-map")
        ?.setAttribute("scale", (this.config.maxDisp * ds).toString());

      this.renderOptics();
      this.updateClone();

      if (this.state.isAnimating || !this.springs.progress.isSettled()) {
        this.af = requestAnimationFrame(this.loop);
      } else {
        this.af = null;
      }
    };

    private startLoop() {
      if (!this.af) this.af = requestAnimationFrame(this.loop);
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    new ProgressExhibit();
  });
</script>
