---
import SvgFilter from "../atoms/SvgFilter.astro";

const filterId = "tabs-glass-filter";
const tabH = 48;
const tabR = 24;
---

<div class="relative w-full h-full flex flex-col items-center justify-center p-8 bg-gray-50 dark:bg-[#111]" id="tabs-demo-area">
  
  <!-- Real World Background -->
  <div id="tabs-real-world" class="absolute inset-0 pointer-events-none overflow-hidden bg-slate-950">
    <!-- Diamond mesh grid -->
    <div class="absolute inset-0 opacity-20" style="background-image: repeating-linear-gradient(45deg, #ffffff 0, #ffffff 1px, transparent 1px, transparent 40px), repeating-linear-gradient(-45deg, #ffffff 0, #ffffff 1px, transparent 1px, transparent 40px);"></div>
    
    <!-- Glowing orbs -->
    <div class="absolute w-[300px] h-[300px] bg-rose-500 rounded-full blur-[80px] top-[10%] left-[20%] mix-blend-screen opacity-50"></div>
    <div class="absolute w-[400px] h-[400px] bg-blue-600 rounded-full blur-[80px] bottom-[10%] right-[10%] mix-blend-screen opacity-50"></div>
    
    <!-- Sharp neon line to refract -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[150%] h-[2px] bg-fuchsia-400 shadow-[0_0_20px_#d946ef] rotate-[-8deg]"></div>
  </div>

  <SvgFilter filterId={filterId} width={200} height={tabH} />

  <!-- The Tabs Container -->
  <div
    class="relative flex p-1.5 rounded-full z-10"
    id="liquid-tabs-container"
    style="background: rgba(0,0,0,0.4); border: 1px solid rgba(255,255,255,0.08); box-shadow: inset 0 2px 5px rgba(0,0,0,0.5);"
  >
    
    <!-- The Glass Active Indicator -->
    <div 
      class="absolute will-change-transform touch-none" 
      id="liquid-tabs-indicator"
      style={`top: 6px; left: 6px; height: calc(100% - 12px); border-radius: ${tabR}px; overflow: hidden;`}
    >
      <div
        id="tabs-content-clone"
        class="glass-clone-wrap"
        style={`border-radius: ${tabR}px;`}
      >
        <div id="tabs-clone-inner" class="glass-clone-inner absolute inset-0"></div>
      </div>
      <div
        class="glass-inner-overlay"
        style={`border-radius: ${tabR}px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.2); box-shadow: 0 10px 30px rgba(0,0,0,0.5), inset 0 2px 5px rgba(255,255,255,0.3), inset 0 0 20px rgba(255,255,255,0.1);`}
      ></div>
      <div
        id="tabs-specular-img"
        class="absolute inset-0 pointer-events-none opacity-80 mix-blend-screen z-10"
        style={`border-radius: ${tabR}px;`}
      ></div>
    </div>
    
    <!-- Tab Buttons -->
    <button class="liquid-tab relative z-10 px-8 py-3 text-sm font-semibold tracking-wide text-white transition-colors duration-300 focus:outline-none rounded-full" data-index="0">Design</button>
    <button class="liquid-tab relative z-10 px-8 py-3 text-sm font-semibold tracking-wide text-white/40 transition-colors duration-300 focus:outline-none rounded-full" data-index="1">Physics</button>
    <button class="liquid-tab relative z-10 px-8 py-3 text-sm font-semibold tracking-wide text-white/40 transition-colors duration-300 focus:outline-none rounded-full" data-index="2">Optics</button>
    <button class="liquid-tab relative z-10 px-8 py-3 text-sm font-semibold tracking-wide text-white/40 transition-colors duration-300 focus:outline-none rounded-full" data-index="3">Settings</button>

  </div>
</div>

<script>
  import { Spring } from "../../quarks/spring";
  import { SurfaceEquations } from "../../quarks/surfaceEquations";
  import {
    calculateDisplacementMap1D,
    calculateDisplacementMap2D,
    calculateSpecularHighlight,
    imageDataToDataURL,
  } from "../../quarks/surfaceRenderer";

  class TabsExhibit {
    private container: HTMLElement;
    private indicator: HTMLElement;
    private tabs: NodeListOf<HTMLElement>;
    private cloneInner: HTMLElement;
    private cloneWrapper: HTMLElement;
    private demoArea: HTMLElement;
    
    private config = { w: 100, h: 48, bw: 14, gt: 40, r: 24, ri: 1.5, maxDisp: 0 };
    private state = { activeIndex: 0, targetLeft: 0, targetWidth: 0 };
    
    private springs = {
      x: new Spring(0, 350, 30),
      width: new Spring(100, 350, 30),
      scale: new Spring(1, 400, 25),
      dispScale: new Spring(1, 300, 20)
    };
    
    private af: number | null = null;

    constructor() {
      this.container = document.getElementById('liquid-tabs-container') as HTMLElement;
      this.indicator = document.getElementById('liquid-tabs-indicator') as HTMLElement;
      this.tabs = this.container.querySelectorAll('.liquid-tab');
      this.cloneInner = document.getElementById('tabs-clone-inner') as HTMLElement;
      this.cloneWrapper = document.getElementById('tabs-content-clone') as HTMLElement;
      this.demoArea = document.getElementById('tabs-demo-area') as HTMLElement;

      if (!this.container) return;
      this.init();
    }

    private init() {
      const rw = document.getElementById('tabs-real-world');
      if (rw) this.cloneInner.innerHTML = rw.outerHTML;
      this.cloneWrapper.style.filter = "url(#tabs-glass-filter)";

      const activeTab = this.tabs[0];
      const contRect = this.container.getBoundingClientRect();
      const tabRect = activeTab.getBoundingClientRect();
      
      this.state.targetWidth = tabRect.width;
      this.state.targetLeft = tabRect.left - contRect.left - 6;
      
      this.springs.width.value = this.state.targetWidth;
      this.springs.x.value = this.state.targetLeft;
      this.config.w = this.state.targetWidth;
      this.config.h = tabRect.height;
      this.config.r = tabRect.height / 2;

      this.renderOptics();

      this.tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => this.setActiveTab(index, tab));
      });

      window.addEventListener('resize', this.onResize.bind(this));
      
      this.updateClone();
      this.startLoop();
    }

    private setActiveTab(index: number, tab: HTMLElement) {
      if (this.state.activeIndex === index) return;
      
      this.state.activeIndex = index;
      
      this.tabs.forEach((t, i) => {
        t.style.color = i === index ? 'white' : 'rgba(255,255,255,0.4)';
      });
      
      const contRect = this.container.getBoundingClientRect();
      const tabRect = tab.getBoundingClientRect();
      
      this.state.targetWidth = tabRect.width;
      this.state.targetLeft = tabRect.left - contRect.left - 6;

      this.springs.width.setTarget(this.state.targetWidth);
      this.springs.x.setTarget(this.state.targetLeft);
      
      const distance = Math.abs(this.springs.x.value - this.state.targetLeft);
      if (distance > 10) {
          this.springs.scale.setTarget(0.9);
          this.springs.dispScale.setTarget(1.8);
          setTimeout(() => {
              this.springs.scale.setTarget(1);
              this.springs.dispScale.setTarget(1);
          }, 150);
      }

      this.startLoop();
    }

    private renderOptics() {
      if (this.config.w < 10) return;
      
      const intW = Math.round(this.config.w);
      const intH = Math.round(this.config.h);

      const pc = calculateDisplacementMap1D(this.config.gt, this.config.bw, SurfaceEquations.convex_squircle, this.config.ri);
      this.config.maxDisp = Math.max(...pc.map(Math.abs));

      const dispData = calculateDisplacementMap2D(intW, intH, intW, intH, this.config.r, this.config.bw, this.config.maxDisp || 1, pc);
      const specData = calculateSpecularHighlight(intW, intH, this.config.r, this.config.bw);

      const filterImg = document.getElementById("tabs-glass-filter-image");
      if (filterImg) {
          filterImg.setAttribute("href", imageDataToDataURL(dispData));
          filterImg.setAttribute("x", "0");
          filterImg.setAttribute("y", "0");
          filterImg.setAttribute("width", "100%");
          filterImg.setAttribute("height", "100%");
          filterImg.setAttribute("preserveAspectRatio", "none");
      }
      
      const specImg = document.getElementById("tabs-specular-img");
      if (specImg) {
        specImg.style.backgroundImage = `url(${imageDataToDataURL(specData)})`;
        specImg.style.backgroundSize = "100% 100%";
      }
    }

    private onResize() {
      const activeTab = this.tabs[this.state.activeIndex];
      const contRect = this.container.getBoundingClientRect();
      const tabRect = activeTab.getBoundingClientRect();
      
      this.state.targetWidth = tabRect.width;
      this.state.targetLeft = tabRect.left - contRect.left - 6;
      
      this.springs.width.value = this.state.targetWidth;
      this.springs.width.setTarget(this.state.targetWidth);
      
      this.springs.x.value = this.state.targetLeft;
      this.springs.x.setTarget(this.state.targetLeft);
      
      this.config.w = this.state.targetWidth;
      this.config.h = tabRect.height;
      this.config.r = tabRect.height / 2;
      this.renderOptics();
      this.updateClone();
      this.startLoop();
    }

    private updateClone() {
      const aR = this.demoArea.getBoundingClientRect();
      const contRect = this.container.getBoundingClientRect();
      
      this.cloneInner.style.width = aR.width + "px";
      this.cloneInner.style.height = aR.height + "px";
      
      const sc = this.springs.scale.value;
      const curX = this.springs.x.value;
      
      const offsetX = this.container.offsetLeft + curX + 6;
      const offsetY = this.container.offsetTop + 6;

      this.cloneInner.style.transform = `scale(${1/sc}) translate(${-offsetX}px, ${-offsetY}px)`;
    }

    private loop = () => {
      const dt = Math.min(0.032, 1 / 60);
      
      const x = this.springs.x.update(dt);
      const w = this.springs.width.update(dt);
      const sc = this.springs.scale.update(dt);
      const ds = this.springs.dispScale.update(dt);
      
      this.indicator.style.transform = `translateX(${x}px) scale(${sc}, ${sc > 1 ? 2 - sc : sc})`;
      this.indicator.style.width = `${w}px`;
      
      if (Math.abs(w - this.config.w) > 5) {
          this.config.w = w;
      }
      
      if (this.springs.width.isSettled() && Math.abs(w - this.config.w) > 5) {
          this.renderOptics();
      }

      document.getElementById("tabs-glass-filter-map")?.setAttribute("scale", (this.config.maxDisp * ds).toString());

      this.updateClone();

      if (!Object.values(this.springs).every(s => s.isSettled())) {
        this.af = requestAnimationFrame(this.loop);
      } else {
        this.af = null;
      }
    };

    private startLoop() {
      if (!this.af) this.af = requestAnimationFrame(this.loop);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    new TabsExhibit();
  });
</script>
