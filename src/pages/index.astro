---
import MainLayout from "../layouts/MainLayout.astro";
import ExhibitCard from "../components/molecules/ExhibitCard.astro";
import ControlsModal from "../components/molecules/ControlsModal.astro";
import LiquidControls from "../components/molecules/LiquidControls.astro";
import LensExhibit from "../components/organisms/LensExhibit.astro";
import ButtonExhibit from "../components/organisms/ButtonExhibit.astro";
import SwitchExhibit from "../components/organisms/SwitchExhibit.astro";
import SliderExhibit from "../components/organisms/SliderExhibit.astro";
import CursorExhibit from "../components/organisms/CursorExhibit.astro";
import InputExhibit from "../components/organisms/InputExhibit.astro";

import LayeredFabExhibit from "../components/organisms/LayeredFabExhibit.astro";
import CreditCardExhibit from "../components/organisms/CreditCardExhibit.astro";
import TopNav from "../components/molecules/TopNav.astro";
import { galleryControls } from "../lib/galleryControls";
import { projectLinks } from "../lib/site";

const buttonControls = galleryControls.button;
const switchControls = galleryControls.switch;
const cursorControls = galleryControls.cursor;
const inputControls = galleryControls.input;
const fabControls = galleryControls.fab;
const cardControls = galleryControls.card;
---

<MainLayout title="Liquid Glass - Interactive Gallery">
  <div
    class="min-h-screen bg-gray-50 dark:bg-black text-gray-900 dark:text-gray-100 selection:bg-black selection:text-white dark:selection:bg-white dark:selection:text-black"
  >
    <TopNav currentPath="/" />

    <!-- Hero Header -->
    <header
      class="w-full px-8 py-24 md:py-32 border-b border-gray-200 dark:border-gray-800 bg-white dark:bg-[#0a0a0a]"
    >
      <div class="max-w-screen-2xl mx-auto">
        <h1
          class="font-display text-5xl md:text-7xl font-bold tracking-tighter leading-none mb-12"
        >
          Liquid Glass
        </h1>
        <p
          class="text-xl md:text-2xl font-light text-gray-500 dark:text-gray-400 max-w-2xl leading-relaxed"
        >
          A study of refraction, optics, and surface tension on the web. Built
          with pure mathematics, SVG displacement maps, and Astro.
        </p>
        <div class="mt-10 flex flex-wrap gap-3">
          <a
            href="/how-it-works"
            class="rounded-full bg-gray-900 px-5 py-2.5 text-xs uppercase tracking-[0.22em] text-white transition hover:bg-gray-700 dark:bg-white dark:text-black dark:hover:bg-gray-200"
          >
            How It Works
          </a>
          <a
            href="/svg-generator"
            class="rounded-full border border-gray-300 px-5 py-2.5 text-xs uppercase tracking-[0.22em] text-gray-700 transition hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-white/10"
          >
            SVG Generator
          </a>
          <a
            href={projectLinks.github.url}
            target="_blank"
            rel="noreferrer"
            class="rounded-full border border-gray-300 px-5 py-2.5 text-xs uppercase tracking-[0.22em] text-gray-700 transition hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-white/10"
          >
            View Code
          </a>
        </div>
      </div>
    </header>

    <section
      class="border-b border-gray-200 bg-[#f6f3ec] dark:border-gray-800 dark:bg-[#0b0d11]"
    >
      <div
        class="mx-auto grid max-w-screen-2xl gap-px border-l border-gray-200 bg-gray-200 md:grid-cols-3 dark:border-gray-800 dark:bg-gray-800"
      >
        <a
          href="/how-it-works"
          class="bg-white p-6 transition hover:bg-[#f8f4ee] dark:bg-[#0a0a0a] dark:hover:bg-[#111318]"
        >
          <span
            class="text-[10px] uppercase tracking-[0.28em] text-gray-500 dark:text-gray-400"
            >Explain</span
          >
          <h2
            class="mt-4 font-display text-[1.6rem] leading-[3] tracking-[0.03em] text-gray-900 dark:text-white sm:text-[1.85rem]"
          >
            How It Works
          </h2>
          <p class="mt-3 max-w-sm text-sm text-gray-600 dark:text-gray-400">
            Breakdown of the math, the SVG pipeline, and the implementation
            choices behind the refraction effect.
          </p>
        </a>
        <a
          href="/svg-generator"
          class="bg-white p-6 transition hover:bg-[#f8f4ee] dark:bg-[#0a0a0a] dark:hover:bg-[#111318]"
        >
          <span
            class="text-[10px] uppercase tracking-[0.28em] text-gray-500 dark:text-gray-400"
            >Tool</span
          >
          <h2
            class="mt-4 font-display text-[1.6rem] leading-[3] tracking-[0.03em] text-gray-900 dark:text-white sm:text-[1.85rem]"
          >
            SVG Generator
          </h2>
          <p class="mt-3 max-w-sm text-sm text-gray-600 dark:text-gray-400">
            Tune the liquid glass parameters and copy a self-contained SVG
            filter snippet for your own site.
          </p>
        </a>
        <a
          href={projectLinks.article.url}
          target="_blank"
          rel="noreferrer"
          class="bg-white p-6 transition hover:bg-[#f8f4ee] dark:bg-[#0a0a0a] dark:hover:bg-[#111318]"
        >
          <span
            class="text-[10px] uppercase tracking-[0.28em] text-gray-500 dark:text-gray-400"
            >Reference</span
          >
          <h2
            class="mt-4 font-display text-[1.6rem] leading-[3] tracking-[0.03em] text-gray-900 dark:text-white sm:text-[1.85rem]"
          >
            Article Base
          </h2>
          <p class="mt-3 max-w-sm text-sm text-gray-600 dark:text-gray-400">
            Credit to the original article that sparked the effect and guided
            the refraction-first approach.
          </p>
        </a>
      </div>
    </section>

    <!-- Gallery Grid -->
    <main
      class="w-full max-w-screen-2xl mx-auto border-l border-gray-200 dark:border-gray-800"
    >
      <div class="grid grid-cols-1 md:grid-cols-12">
        <ExhibitCard
          number="01"
          title="The Lens"
          description="A free-floating magnifying glass demonstrating real-time backdrop refraction and chromatic aberration over complex DOM elements."
          span="col-span-12"
        >
          <LensExhibit />
        </ExhibitCard>

        <ExhibitCard
          number="02"
          title="Action Button"
          description="A hyper-tactile button with inner tension. Click and hold to feel the surface pull inward."
          span="col-span-12 md:col-span-6"
        >
          <ControlsModal
            slot="actions"
            id={buttonControls.modal.id}
            title={buttonControls.modal.title}
            panelDataAttr={buttonControls.modal.panelDataAttr}
            closeDataAttr={buttonControls.modal.closeDataAttr}
            triggerDataAttr={buttonControls.modal.triggerDataAttr}
            triggerLabel={buttonControls.modal.triggerLabel}
            panelSide={buttonControls.modal.panelSide}
            panelAlign={buttonControls.modal.panelAlign}
          >
            <LiquidControls
              title={buttonControls.panelTitle}
              target={buttonControls.target}
              compact={true}
              className="mt-0! max-w-none border-transparent bg-transparent shadow-none"
              controls={buttonControls.controls}
            />
          </ControlsModal>
          <ButtonExhibit />
        </ExhibitCard>

        <ExhibitCard
          number="03"
          title="The Switch"
          description="A toggle switch with physical mass. Drag or click to snap. Refraction intensity increases when pressed."
          span="col-span-12 md:col-span-6"
        >
          <ControlsModal
            slot="actions"
            id={switchControls.modal.id}
            title={switchControls.modal.title}
            panelDataAttr={switchControls.modal.panelDataAttr}
            closeDataAttr={switchControls.modal.closeDataAttr}
            triggerDataAttr={switchControls.modal.triggerDataAttr}
            triggerLabel={switchControls.modal.triggerLabel}
            panelSide={switchControls.modal.panelSide}
            panelAlign={switchControls.modal.panelAlign}
          >
            <LiquidControls
              title={switchControls.panelTitle}
              target={switchControls.target}
              compact={true}
              className="mt-0! max-w-none border-transparent bg-transparent shadow-none"
              controls={switchControls.controls}
            />
          </ControlsModal>
          <SwitchExhibit />
        </ExhibitCard>

        <ExhibitCard
          number="04"
          title="The Slider"
          description="A liquid slider track. The glass thumb stretches and distorts based on dragging velocity."
          span="col-span-12"
        >
          <SliderExhibit />
        </ExhibitCard>

        <ExhibitCard
          number="05"
          title="The Cursor"
          description="A custom glass pointer with spring physics, stretching and refracting based on velocity."
          span="col-span-12 md:col-span-6"
        >
          <ControlsModal
            slot="actions"
            id={cursorControls.modal.id}
            title={cursorControls.modal.title}
            panelDataAttr={cursorControls.modal.panelDataAttr}
            closeDataAttr={cursorControls.modal.closeDataAttr}
            triggerDataAttr={cursorControls.modal.triggerDataAttr}
            triggerLabel={cursorControls.modal.triggerLabel}
            panelSide={cursorControls.modal.panelSide}
            panelAlign={cursorControls.modal.panelAlign}
          >
            <LiquidControls
              title={cursorControls.panelTitle}
              target={cursorControls.target}
              compact={true}
              className="mt-0! max-w-none border-transparent bg-transparent shadow-none"
              controls={cursorControls.controls}
            />
          </ControlsModal>
          <CursorExhibit />
        </ExhibitCard>

        <ExhibitCard
          number="06"
          title="Liquid Input"
          description="A glass input field that reacts to typing with microscopic physical tremors and refraction bursts."
          span="col-span-12 md:col-span-6"
        >
          <ControlsModal
            slot="actions"
            id={inputControls.modal.id}
            title={inputControls.modal.title}
            panelDataAttr={inputControls.modal.panelDataAttr}
            closeDataAttr={inputControls.modal.closeDataAttr}
            triggerDataAttr={inputControls.modal.triggerDataAttr}
            triggerLabel={inputControls.modal.triggerLabel}
            panelSide={inputControls.modal.panelSide}
            panelAlign={inputControls.modal.panelAlign}
          >
            <LiquidControls
              title={inputControls.panelTitle}
              target={inputControls.target}
              compact={true}
              className="mt-0! max-w-none border-transparent bg-transparent shadow-none"
              controls={inputControls.controls}
            />
          </ControlsModal>
          <InputExhibit />
        </ExhibitCard>

        <ExhibitCard
          number="07"
          title="Layered FAB"
          description="A floating action button whose stacked glass pieces push and settle against each other."
          span="col-span-12 md:col-span-6"
        >
          <ControlsModal
            slot="actions"
            id={fabControls.modal.id}
            title={fabControls.modal.title}
            panelDataAttr={fabControls.modal.panelDataAttr}
            closeDataAttr={fabControls.modal.closeDataAttr}
            triggerDataAttr={fabControls.modal.triggerDataAttr}
            triggerLabel={fabControls.modal.triggerLabel}
            panelSide={fabControls.modal.panelSide}
            panelAlign={fabControls.modal.panelAlign}
          >
            <LiquidControls
              title={fabControls.panelTitle}
              target={fabControls.target}
              compact={true}
              className="mt-0! max-w-none border-transparent bg-transparent shadow-none"
              controls={fabControls.controls}
            />
          </ControlsModal>
          <LayeredFabExhibit />
        </ExhibitCard>

        <ExhibitCard
          number="08"
          title="Liquid Credit Card"
          description="An interactive, 3D parallax credit card floating over animated circles."
          span="col-span-12 md:col-span-6"
        >
          <ControlsModal
            slot="actions"
            id={cardControls.modal.id}
            title={cardControls.modal.title}
            panelDataAttr={cardControls.modal.panelDataAttr}
            closeDataAttr={cardControls.modal.closeDataAttr}
            triggerDataAttr={cardControls.modal.triggerDataAttr}
            triggerLabel={cardControls.modal.triggerLabel}
            panelSide={cardControls.modal.panelSide}
            panelAlign={cardControls.modal.panelAlign}
          >
            <LiquidControls
              title={cardControls.panelTitle}
              target={cardControls.target}
              compact={true}
              className="mt-0! max-w-none border-transparent bg-transparent shadow-none"
              controls={cardControls.controls}
            />
          </ControlsModal>
          <CreditCardExhibit />
        </ExhibitCard>
      </div>
    </main>
  </div>
</MainLayout>
