            if (details) details.open = false;
            syncSelectFields();
            render();
          });
        });

      resetButton?.addEventListener("click", () => {
        Object.assign(state, defaults);
        drag.x = 0;
        drag.y = 0;
        controls
          .querySelectorAll<HTMLInputElement>("[data-key]")
          .forEach((input) => {
            const key = input.dataset.key as keyof typeof state;
            const nextValue = state[key];
            input.value = String(nextValue);
            const valueNode = controls.querySelector<HTMLElement>(
              `[data-value-for="${input.dataset.key}"]`,
            );
            if (valueNode) valueNode.textContent = input.value;
          });
        syncSelectFields();
        render();
      });

      copyHtmlButton?.addEventListener("click", async () => {
        await navigator.clipboard.writeText(htmlOutput.value);
        copyHtmlButton.textContent = "Copied";
        window.setTimeout(() => {
          copyHtmlButton.textContent = "Copy HTML";
        }, 1400);
      });

      copyCssButton?.addEventListener("click", async () => {
        await navigator.clipboard.writeText(cssOutput.value);
        copyCssButton.textContent = "Copied";
        window.setTimeout(() => {
          copyCssButton.textContent = "Copy CSS";
        }, 1400);
      });

      copySvgOnlyButton?.addEventListener("click", async () => {
        await navigator.clipboard.writeText(svgOutput.value);
        copySvgOnlyButton.textContent = "Copied";
        window.setTimeout(() => {
          copySvgOnlyButton.textContent = "Copy SVG";
        }, 1400);
      });

      copyTailwindButton?.addEventListener("click", async () => {
        await navigator.clipboard.writeText(tailwindOutput.value);
        copyTailwindButton.textContent = "Copied";
        window.setTimeout(() => {
          copyTailwindButton.textContent = "Copy Tailwind";
        }, 1400);
      });

      copyJsButton?.addEventListener("click", async () => {
        await navigator.clipboard.writeText(jsOutput.value);
        copyJsButton.textContent = "Copied";
        window.setTimeout(() => {
          copyJsButton.textContent = "Copy JS";
        }, 1400);
      });

      copyButton?.addEventListener("click", async () => {
        await navigator.clipboard.writeText(composePackage());
        copyButton.textContent = "Copied";
        window.setTimeout(() => {
          copyButton.textContent = "Copy code";
        }, 1400);
      });

      downloadButton?.addEventListener("click", () => {
        const blob = new Blob([composePackage()], {
          type: "text/html;charset=utf-8",
        });
        const url = URL.createObjectURL(blob);
        const anchor = document.createElement("a");
        anchor.href = url;
        anchor.download = `${state.filterName || "liquid-glass"}.html`;
        anchor.click();
        URL.revokeObjectURL(url);
      });

      glass.addEventListener("pointerdown", (event) => {
        drag.active = true;
        drag.startX = event.clientX - drag.x;
        drag.startY = event.clientY - drag.y;
        glass.setPointerCapture(event.pointerId);
        glass.classList.add("is-dragging");
      });

      glass.addEventListener("pointermove", (event) => {
        if (!drag.active) return;
        drag.x = event.clientX - drag.startX;
        drag.y = event.clientY - drag.startY;
        clampDrag();
        applyGlassPosition();
      });

      const endDrag = (event?: PointerEvent) => {
        drag.active = false;
        if (event) glass.releasePointerCapture(event.pointerId);
        glass.classList.remove("is-dragging");
      };

      glass.addEventListener("pointerup", endDrag);
      glass.addEventListener("pointercancel", endDrag);

      window.addEventListener("resize", () => {
        clampDrag();
        applyGlassPosition();
      });
      document.addEventListener("click", (event) => {
        const target = event.target as Node;
        controls
          .querySelectorAll<HTMLDetailsElement>("[data-generator-select]")
          .forEach((details) => {
            if (!details.contains(target)) details.open = false;
          });
      });
      syncSelectFields();
      render();
    }
  </script>

  <style>
    /* Class-based so the styling survives when the layer is cloned into the
       refracted glass layer (syncCloneContent strips ids). Keeping this on an
       id selector froze the refracted background and reset its scale. */
    .generator-bg-layer {
      background-position: center center;
      background-repeat: repeat;
      background-size: 560px auto;
      animation: generatorBgMove 60s linear infinite;
    }

    @keyframes generatorBgMove {
      from {
        background-position: 0% 0%;
      }

      to {
        background-position: 0% -1000%;
      }
    }

    #generator-glass {
      cursor: grab;
      touch-action: none;
    }

    #generator-glass.is-dragging {
      cursor: grabbing;
    }
  </style>
</MainLayout>
