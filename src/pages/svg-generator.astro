---
import botanical from "@assets/tropical-floral-pattern-dark.webp";
import SelectField from "@components/atoms/SelectField.astro";
import SvgFilter from "@components/atoms/SvgFilter.astro";
import TopNav from "@components/molecules/TopNav.astro";
import MainLayout from "@layouts/MainLayout.astro";
import { projectLinks } from "@lib/site";

const filterId = "exported-liquid-filter";
---

<MainLayout title="SVG Generator - Liquid Glass">
  <div
    class="min-h-screen bg-[#f4f1ea] text-gray-900 dark:bg-black dark:text-gray-100"
  >
    <TopNav currentPath="/svg-generator" />

    <header
      class="border-b border-gray-200 bg-white px-4 py-14 sm:px-6 md:px-8 md:py-20 dark:border-gray-800 dark:bg-[#0a0a0a]"
    >
      <div class="mx-auto max-w-screen-2xl">
        <span
          class="text-[10px] uppercase tracking-[0.3em] text-gray-500 dark:text-gray-400"
          >Tooling</span
        >
        <h1
          class="mt-5 md:mt-10 font-display
         text-[1.8rem] sm:text-[2.5rem] md:text-[3.5rem] lg:text-[4.5rem] xl:text-5xl
         leading-[3] tracking-[-0.02em]"
        >
          SVG Generator
        </h1>
        <p
          class="mt-5 max-w-3xl text-base leading-relaxed text-gray-600 sm:text-lg dark:text-gray-400"
        >
          Tune the surface, preview the distortion in motion, and download the
          filter with the base CSS helpers needed to wire the glass layer into a
          real component.
        </p>
      </div>
    </header>

    <main
      class="mx-auto grid max-w-screen-2xl gap-6 px-4 py-8 sm:px-6 md:px-8 md:py-12 lg:grid-cols-[minmax(0,1fr)_24rem] lg:gap-8"
    >
      <section class="space-y-8">
        <article
          class="overflow-hidden rounded-4xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-[#0b0d11]"
        >
          <div
            id="generator-scene"
            class="relative min-h-80 overflow-hidden bg-[#0d1218] sm:min-h-96 md:min-h-120"
          >
            <div
              id="generator-real-world"
              class="absolute inset-0 overflow-hidden"
            >
              <div
                id="generator-background"
                class="generator-bg-layer absolute inset-0 opacity-90"
                style={`background-image: url(${botanical.src});`}
                data-background-url={botanical.src}
              >
              </div>
              <div
                class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(255,255,255,0.12),transparent_35%),linear-gradient(180deg,rgba(9,14,20,0.1),rgba(5,8,12,0.72))]"
              >
              </div>
              <div
                class="absolute inset-0 z-2 flex items-center justify-center"
              >
                <span
                  class="px-4 text-center font-display text-3xl text-white/75 drop-shadow-[0_8px_24px_rgba(0,0,0,0.45)] sm:text-4xl"
                  >Preview Layer</span
                >
              </div>
            </div>

            <div
              class="absolute inset-0 flex items-center justify-center p-4 sm:p-6 md:p-10"
            >
              <div
                id="generator-glass"
                class="absolute left-1/2 top-1/2 z-20 overflow-hidden"
                style="width: 280px; height: 180px; border-radius: 36px; transform: translate(-50%, -50%);"
              >
                <div
                  class="pointer-events-none absolute inset-0 overflow-hidden rounded-[inherit]"
                >
                  <div
                    id="generator-content-clone"
                    class="glass-clone-wrap absolute inset-0 rounded-[inherit]"
                  >
                    <div id="generator-clone-inner" class="glass-clone-inner">
                    </div>
                  </div>
                </div>

                <SvgFilter filterId={filterId} width={280} height={180} />

                <div
                  class="glass-inner-overlay rounded-[inherit] border border-white/25 bg-white/8 shadow-[0_24px_60px_rgba(0,0,0,0.28),inset_0_2px_12px_rgba(255,255,255,0.3),inset_0_-2px_10px_rgba(0,0,0,0.32)]"
                >
                </div>
              </div>
            </div>
          </div>
        </article>

        <article
          class="rounded-4xl border border-gray-200 bg-white p-4 sm:p-6 dark:border-gray-800 dark:bg-[#0b0d11]"
        >
          <div
            class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center"
          >
            <div>
              <span
                class="text-[10px] uppercase tracking-[0.28em] text-gray-500 dark:text-gray-400"
                >Export</span
              >
              <h2
                class="mt-3 font-display text-[1.5rem] leading-22 tracking-[0.03em] sm:text-[1.9rem]"
              >
                Export Package
              </h2>
            </div>
            <div class="flex w-full flex-col gap-2 sm:w-auto sm:flex-row">
              <button
                id="copy-svg-button"
                type="button"
                class="w-full rounded-full border border-gray-200 px-4 py-2 text-xs uppercase tracking-[0.2em] text-gray-700 transition hover:bg-gray-100 sm:w-auto dark:border-gray-700 dark:text-gray-300 dark:hover:bg-white/10"
              >
                Copy code
              </button>
              <button
                id="download-svg-button"
                type="button"
                class="w-full rounded-full bg-gray-900 px-4 py-2 text-xs uppercase tracking-[0.2em] text-white transition hover:bg-gray-700 sm:w-auto dark:bg-white dark:text-black dark:hover:bg-gray-200"
              >
                Download .html
              </button>
            </div>
          </div>

          <ol
            class="mt-6 flex flex-col gap-1.5 text-sm leading-6 text-gray-600 dark:text-gray-400"
          >
            <li>
              <span class="font-semibold text-gray-900 dark:text-gray-100"
                >1.</span
              > Press <span class="font-semibold">Download .html</span> (or Copy
              code and save it as a
              <code class="rounded bg-black/5 px-1 dark:bg-white/10">.html</code>
              file).
            </li>
            <li>
              <span class="font-semibold text-gray-900 dark:text-gray-100"
                >2.</span
              > Open that file in your browser — the glass already works (all
              browsers).
            </li>
            <li>
              <span class="font-semibold text-gray-900 dark:text-gray-100"
                >3.</span
              > Inside, replace
              <code class="rounded bg-black/5 px-1 dark:bg-white/10"
                >#your-background</code
              > with your own image or section.
            </li>
          </ol>

          <div
            class="mt-4 overflow-hidden rounded-3xl border border-gray-200 bg-[#f7f4ee] dark:border-gray-700 dark:bg-[#0f1217]"
          >
            <textarea
              id="generator-package-output"
              readonly
              class="block h-80 w-full resize-none border-0 bg-transparent p-4 pr-5 font-mono text-[11px] leading-6 text-gray-700 outline-none sm:p-5 sm:pr-6 sm:text-xs dark:text-gray-300"
            ></textarea>
          </div>

          <details
            class="mt-6 overflow-hidden rounded-3xl border border-gray-200 dark:border-gray-700"
          >
            <summary
              class="cursor-pointer select-none px-4 py-3 text-[10px] uppercase tracking-[0.22em] text-gray-500 transition hover:text-gray-800 dark:text-gray-400 dark:hover:text-gray-200"
            >
              Individual files (advanced)
            </summary>
            <div class="px-4 pb-4">
              <div class="grid gap-4 xl:grid-cols-2">
            <div>
              <div class="flex items-center justify-between gap-3">
                <span
                  class="text-[10px] uppercase tracking-[0.22em] text-gray-500 dark:text-gray-400"
                  >Generated CSS</span
                >
                <button
                  id="copy-css-button"
                  type="button"
                  class="rounded-full border border-gray-200 px-3 py-1.5 text-[10px] uppercase tracking-[0.18em] text-gray-700 transition hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-white/10"
                >
                  Copy CSS
                </button>
              </div>
              <div
                class="mt-3 overflow-hidden rounded-3xl border border-gray-200 bg-[#f7f4ee] dark:border-gray-700 dark:bg-[#0f1217]"
              >
                <textarea
                  id="generator-css-output"
                  readonly
                  class="block h-56 w-full resize-none border-0 bg-transparent p-4 pr-5 font-mono text-[11px] leading-6 text-gray-700 outline-none sm:p-5 sm:pr-6 sm:text-xs dark:text-gray-300"
                ></textarea>
              </div>
            </div>
            <div>
              <div class="flex items-center justify-between gap-3">
                <span
                  class="text-[10px] uppercase tracking-[0.22em] text-gray-500 dark:text-gray-400"
                  >Generated HTML</span
                >
                <button
                  id="copy-html-button"
                  type="button"
                  class="rounded-full border border-gray-200 px-3 py-1.5 text-[10px] uppercase tracking-[0.18em] text-gray-700 transition hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-white/10"
                >
                  Copy HTML
                </button>
              </div>
              <div
                class="mt-3 overflow-hidden rounded-3xl border border-gray-200 bg-[#f7f4ee] dark:border-gray-700 dark:bg-[#0f1217]"
              >
                <textarea
                  id="generator-html-output"
                  readonly
                  class="block h-56 w-full resize-none border-0 bg-transparent p-4 pr-5 font-mono text-[11px] leading-6 text-gray-700 outline-none sm:p-5 sm:pr-6 sm:text-xs dark:text-gray-300"
                ></textarea>
              </div>
            </div>
            <div>
              <div class="flex items-center justify-between gap-3">
                <span
                  class="text-[10px] uppercase tracking-[0.22em] text-gray-500 dark:text-gray-400"
                  >Generated SVG</span
                >
                <button
                  id="copy-svg-only-button"
                  type="button"
                  class="rounded-full border border-gray-200 px-3 py-1.5 text-[10px] uppercase tracking-[0.18em] text-gray-700 transition hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-white/10"
                >
                  Copy SVG
                </button>
              </div>
              <div
                class="mt-3 overflow-hidden rounded-3xl border border-gray-200 bg-[#f7f4ee] dark:border-gray-700 dark:bg-[#0f1217]"
              >
                <textarea
                  id="generator-svg-output"
                  readonly
                  class="block h-56 w-full resize-none border-0 bg-transparent p-4 pr-5 font-mono text-[11px] leading-6 text-gray-700 outline-none sm:p-5 sm:pr-6 sm:text-xs dark:text-gray-300"
                ></textarea>
              </div>
            </div>
            <div>
              <div class="flex items-center justify-between gap-3">
                <span
                  class="text-[10px] uppercase tracking-[0.22em] text-gray-500 dark:text-gray-400"
                  >Generated Tailwind</span
                >
                <button
                  id="copy-tailwind-button"
                  type="button"
                  class="rounded-full border border-gray-200 px-3 py-1.5 text-[10px] uppercase tracking-[0.18em] text-gray-700 transition hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-white/10"
                >
                  Copy Tailwind
                </button>
              </div>
              <div
                class="mt-3 overflow-hidden rounded-3xl border border-gray-200 bg-[#f7f4ee] dark:border-gray-700 dark:bg-[#0f1217]"
              >
                <textarea
                  id="generator-tailwind-output"
                  readonly
                  class="block h-56 w-full resize-none border-0 bg-transparent p-4 pr-5 font-mono text-[11px] leading-6 text-gray-700 outline-none sm:p-5 sm:pr-6 sm:text-xs dark:text-gray-300"
                ></textarea>
              </div>
            </div>
            <div>
              <div class="flex items-center justify-between gap-3">
                <span
                  class="text-[10px] uppercase tracking-[0.22em] text-gray-500 dark:text-gray-400"
                  >Generated JS (wire-up)</span
                >
                <button
                  id="copy-js-button"
                  type="button"
                  class="rounded-full border border-gray-200 px-3 py-1.5 text-[10px] uppercase tracking-[0.18em] text-gray-700 transition hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-white/10"
                >
                  Copy JS
                </button>
              </div>
              <div
                class="mt-3 overflow-hidden rounded-3xl border border-gray-200 bg-[#f7f4ee] dark:border-gray-700 dark:bg-[#0f1217]"
              >
                <textarea
                  id="generator-js-output"
                  readonly
                  class="block h-56 w-full resize-none border-0 bg-transparent p-4 pr-5 font-mono text-[11px] leading-6 text-gray-700 outline-none sm:p-5 sm:pr-6 sm:text-xs dark:text-gray-300"
                ></textarea>
              </div>
            </div>
            </div>
            </div>
          </details>
        </article>
      </section>

      <aside class="space-y-6">
        <article
          class="rounded-4xl border border-gray-200 bg-white p-4 sm:p-6 dark:border-gray-800 dark:bg-[#0b0d11]"
        >
          <span
            class="text-[10px] uppercase tracking-[0.28em] text-gray-500 dark:text-gray-400"
            >Controls</span
          >
          <div class="mt-5 space-y-4" id="generator-controls">
            <label
              class="block text-xs uppercase tracking-[0.18em] text-gray-500 dark:text-gray-400"
            >
              Filter Id
              <input
                data-key="filterName"
                value="liquid-glass-custom"
                class="mt-2 w-full rounded-2xl border border-gray-200 bg-transparent px-4 py-3 text-sm normal-case tracking-normal text-gray-900 outline-none dark:border-gray-700 dark:text-white"
              />
            </label>
            <SelectField
              label="Surface"
              keyName="surfaceType"
              value="convex_squircle"
              options={[
                {
                  value: "convex_squircle",
                  label: "Convex Squircle",
                  description: "Balanced rounded glass",
                },
                {
                  value: "convex_circle",
                  label: "Convex Circle",
                  description: "More spherical refraction",
                },
                {
                  value: "concave",
                  label: "Concave",
                  description: "Inset lens behavior",
                },
                {
                  value: "lip",
                  label: "Lip",
                  description: "Raised edge emphasis",
                },
              ]}
            />
            <SelectField
              label="Element Type"
              keyName="elementType"
              value="panel"
              options={[
                {
                  value: "panel",
                  label: "Panel",
                  description: "Wide content surface",
                },
                {
                  value: "button",
                  label: "Button",
                  description: "Compact action shape",
                },
                {
                  value: "card",
                  label: "Card",
                  description: "Broader UI container",
                },
                {
                  value: "pill",
                  label: "Pill",
                  description: "Slim status capsule",
                },
              ]}
            />
            <div class="grid grid-cols-2 gap-4">
              <label
                class="block text-xs uppercase tracking-[0.18em] text-gray-500 dark:text-gray-400"
              >
                <span class="flex items-center justify-between gap-3">
                  <span>Width</span>
                  <span
                    data-value-for="width"
                    class="text-[10px] tracking-[0.08em] text-gray-400 dark:text-gray-500"
                    >280</span
                  >
                </span>
                <input
                  data-key="width"
                  type="range"
                  min="180"
                  max="420"
                  step="2"
                  value="280"
                  class="mt-3 w-full accent-gray-900 dark:accent-white"
                />
              </label>
              <label
                class="block text-xs uppercase tracking-[0.18em] text-gray-500 dark:text-gray-400"
              >
                <span class="flex items-center justify-between gap-3">
                  <span>Height</span>
                  <span
                    data-value-for="height"
                    class="text-[10px] tracking-[0.08em] text-gray-400 dark:text-gray-500"
                    >180</span
                  >
                </span>
                <input
                  data-key="height"
                  type="range"
                  min="120"
                  max="260"
                  step="2"
                  value="180"
                  class="mt-3 w-full accent-gray-900 dark:accent-white"
                />
              </label>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <label
                class="block text-xs uppercase tracking-[0.18em] text-gray-500 dark:text-gray-400"
              >
                <span class="flex items-center justify-between gap-3">
                  <span>Radius</span>
                  <span
                    data-value-for="radius"
                    class="text-[10px] tracking-[0.08em] text-gray-400 dark:text-gray-500"
                    >36</span
                  >
                </span>
                <input
                  data-key="radius"
                  type="range"
                  min="8"
                  max="72"
                  step="1"
                  value="36"
                  class="mt-3 w-full accent-gray-900 dark:accent-white"
                />
              </label>
              <label
                class="block text-xs uppercase tracking-[0.18em] text-gray-500 dark:text-gray-400"
              >
                <span class="flex items-center justify-between gap-3">
                  <span>Bezel</span>
                  <span
                    data-value-for="bezelWidth"
                    class="text-[10px] tracking-[0.08em] text-gray-400 dark:text-gray-500"
                    >24</span
                  >
                </span>
                <input
                  data-key="bezelWidth"
                  type="range"
                  min="8"
                  max="48"
                  step="1"
                  value="24"
                  class="mt-3 w-full accent-gray-900 dark:accent-white"
                />
              </label>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <label
                class="block text-xs uppercase tracking-[0.18em] text-gray-500 dark:text-gray-400"
              >
                <span class="flex items-center justify-between gap-3">
                  <span>Thickness</span>
                  <span
                    data-value-for="glassThickness"
                    class="text-[10px] tracking-[0.08em] text-gray-400 dark:text-gray-500"
                    >120</span
                  >
                </span>
                <input
                  data-key="glassThickness"
                  type="range"
                  min="40"
                  max="220"
                  step="2"
                  value="120"
                  class="mt-3 w-full accent-gray-900 dark:accent-white"
                />
              </label>
              <label
                class="block text-xs uppercase tracking-[0.18em] text-gray-500 dark:text-gray-400"
              >
                <span class="flex items-center justify-between gap-3">
                  <span>IOR</span>
                  <span
                    data-value-for="refractiveIndex"
                    class="text-[10px] tracking-[0.08em] text-gray-400 dark:text-gray-500"
                    >1.45</span
                  >
                </span>
                <input
                  data-key="refractiveIndex"
                  type="range"
                  min="1"
                  max="2"
                  step="0.01"
                  value="1.45"
                  class="mt-3 w-full accent-gray-900 dark:accent-white"
                />
              </label>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <label
                class="block text-xs uppercase tracking-[0.18em] text-gray-500 dark:text-gray-400"
              >
                <span class="flex items-center justify-between gap-3">
                  <span>Blur</span>
                  <span
                    data-value-for="blurStdDev"
                    class="text-[10px] tracking-[0.08em] text-gray-400 dark:text-gray-500"
                    >0.45</span
                  >
                </span>
                <input
                  data-key="blurStdDev"
                  type="range"
                  min="0"
                  max="2"
                  step="0.01"
                  value="0.45"
                  class="mt-3 w-full accent-gray-900 dark:accent-white"
                />
              </label>
              <label
                class="block text-xs uppercase tracking-[0.18em] text-gray-500 dark:text-gray-400"
              >
                <span class="flex items-center justify-between gap-3">
                  <span>Saturation</span>
                  <span
                    data-value-for="saturation"
                    class="text-[10px] tracking-[0.08em] text-gray-400 dark:text-gray-500"
                    >1.15</span
                  >
                </span>
                <input
                  data-key="saturation"
                  type="range"
                  min="0.5"
                  max="4"
                  step="0.01"
                  value="1.15"
                  class="mt-3 w-full accent-gray-900 dark:accent-white"
                />
              </label>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <label
                class="block text-xs uppercase tracking-[0.18em] text-gray-500 dark:text-gray-400"
              >
                <span class="flex items-center justify-between gap-3">
                  <span>Specular</span>
                  <span
                    data-value-for="specularAlpha"
                    class="text-[10px] tracking-[0.08em] text-gray-400 dark:text-gray-500"
                    >0.85</span
                  >
                </span>
                <input
                  data-key="specularAlpha"
                  type="range"
                  min="0"
                  max="1"
                  step="0.01"
                  value="0.85"
                  class="mt-3 w-full accent-gray-900 dark:accent-white"
                />
              </label>
              <label
                class="block text-xs uppercase tracking-[0.18em] text-gray-500 dark:text-gray-400"
              >
                <span class="flex items-center justify-between gap-3">
                  <span>Scale Multiplier</span>
                  <span
                    data-value-for="scaleMultiplier"
                    class="text-[10px] tracking-[0.08em] text-gray-400 dark:text-gray-500"
                    >1.35</span
                  >
                </span>
                <input
                  data-key="scaleMultiplier"
                  type="range"
                  min="0.5"
                  max="2.5"
                  step="0.01"
                  value="1.35"
                  class="mt-3 w-full accent-gray-900 dark:accent-white"
                />
              </label>
            </div>
            <button
              id="generator-reset-button"
              type="button"
              class="w-full rounded-full border border-gray-200 px-4 py-3 text-xs uppercase tracking-[0.2em] text-gray-700 transition hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-white/10"
            >
              Reset Preview
            </button>
          </div>
        </article>

        <article
          class="rounded-4xl border border-gray-200 bg-[#13161b] p-4 text-white sm:p-6 dark:border-gray-800"
        >
          <span class="text-[10px] uppercase tracking-[0.28em] text-white/50"
            >Preview Behavior</span
          >
          <ol class="mt-5 space-y-3 text-sm leading-7 text-white/75">
            <li>
              1. Adjust the surface with the sliders until the distortion feels
              balanced.
            </li>
            <li>
              2. Press and drag the glass panel to inspect edge refraction and
              blur falloff.
            </li>
            <li>
              3. Download the package — it is a complete
              <code class="rounded bg-white/10 px-1">.html</code> file. Open it
              in a browser and the glass already works.
            </li>
            <li>
              4. Inside, swap
              <code class="rounded bg-white/10 px-1">#your-background</code> for
              your own image or section — the numbered STEP comments show exactly
              what to keep and what to replace.
            </li>
          </ol>
          <a
            href={projectLinks.article.url}
            target="_blank"
            rel="noreferrer"
            class="mt-6 inline-flex rounded-full border border-white/15 px-4 py-2 text-xs uppercase tracking-[0.2em] text-white/70 transition hover:bg-white/10 hover:text-white"
          >
            Read the base article
          </a>
        </article>
      </aside>
    </main>
  </div>

  <script>
    import {
      applyLiquidAssets,
      createLiquidAssets,
      syncCloneContent,
      updateLiquidFilter,
    } from "../quarks/liquidGlassEngine";

    const scene = document.getElementById("generator-scene");
    const realWorld = document.getElementById("generator-real-world");
    const glass = document.getElementById("generator-glass");
    const cloneInner = document.getElementById("generator-clone-inner");
    const cloneWrapper = document.getElementById("generator-content-clone");
    const controls = document.getElementById("generator-controls");
    const resetButton = document.getElementById("generator-reset-button");
    const cssOutput = document.getElementById(
      "generator-css-output",
    ) as HTMLTextAreaElement | null;
    const htmlOutput = document.getElementById(
      "generator-html-output",
    ) as HTMLTextAreaElement | null;
    const svgOutput = document.getElementById(
